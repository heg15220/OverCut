{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "RNF-07: esquema de data/balance/audio.json (sonido de la vista en vivo, RF-3D-04, RNF-02). Lo comprueba three/audio/audio.test.js.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sources", "eras", "shiftProfiles", "voicing", "mixer", "ambience", "ui", "safetyCar"],
  "definitions": {
    "shiftProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "match", "glideMs", "transient", "source"],
      "properties": {
        "$comment": {"type": "string"},
        "id": {"type": "string", "minLength": 1},
        "from": {"type": "integer", "minimum": 1950, "maximum": 2100},
        "to": {"type": "integer", "minimum": 1950, "maximum": 2100},
        "match": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"engineId": {"type": "string", "minLength": 1}, "manufacturer": {"type": "string", "minLength": 1}}
        },
        "glideMs": {"type": "number", "exclusiveMinimum": 0, "maximum": 500},
        "transient": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "db"],
          "properties": {
            "kind": {"enum": ["pop", "cut"]},
            "db": {"type": "number", "minimum": -40, "maximum": 12},
            "ms": {"type": "number", "exclusiveMinimum": 0, "maximum": 500}
          }
        },
        "source": {"type": "string", "minLength": 1}
      }
    },
    "positive": {"type": "number", "exclusiveMinimum": 0},
    "nonNegative": {"type": "number", "minimum": 0},
    "share": {"type": "number", "minimum": 0, "maximum": 1},
    "uiTone": {"type": "object", "additionalProperties": false, "required": ["hz", "durationSec"], "properties": {"hz": {"$ref": "#/definitions/positive"}, "durationSec": {"$ref": "#/definitions/positive"}}},
    "rpm": {"type": "integer", "minimum": 1000, "maximum": 25000},
    "text": {"type": "string", "minLength": 1},
    "scPhase": {"enum": ["DEPLOYED", "PICKUP", "TRAIN", "UNLAPPING", "IN_THIS_LAP", "RESTART"]},
    "scCue": {"type": "object", "additionalProperties": false, "required": ["alert", "radio"], "properties": {"alert": {"type": ["string", "null"]}, "radio": {"type": "boolean"}}},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match", "source"],
      "properties": {
        "match": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cylinders": {"type": "integer", "minimum": 2, "maximum": 16},
            "layout": {"enum": ["V", "F", "W", "L"]},
            "aspiration": {"enum": ["na", "turbo", "hybrid"]},
            "engineId": {"$ref": "#/definitions/text"}
          }
        },
        "revLimit": {"$ref": "#/definitions/rpm"},
        "shiftRpm": {"$ref": "#/definitions/rpm"},
        "revLimitByYear": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^(19|20)[0-9]{2}$"},
          "additionalProperties": {"$ref": "#/definitions/rpm"}
        },
        "shiftShare": {"type": "number", "minimum": 0.5, "maximum": 1},
        "source": {"$ref": "#/definitions/text"}
      },
      "dependencies": {"revLimit": ["shiftRpm"], "shiftRpm": ["revLimit"], "revLimitByYear": ["shiftShare"], "shiftShare": ["revLimitByYear"]}
    },
    "era": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "gears", "gearShares", "gearingPerTrack", "refTopKmh", "shiftCutMs", "idleRpm", "launchRpm", "engines", "turbo", "electric", "crackle", "notes"],
      "properties": {
        "id": {"$ref": "#/definitions/text"},
        "from": {"type": "integer", "minimum": 1950, "maximum": 2100},
        "to": {"type": "integer", "minimum": 1950, "maximum": 2100},
        "gears": {"type": "integer", "minimum": 4, "maximum": 8},
        "gearShares": {"type": "array", "minItems": 4, "maxItems": 8, "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}},
        "gearingPerTrack": {"type": "boolean"},
        "refTopKmh": {"$ref": "#/definitions/positive"},
        "shiftCutMs": {"$ref": "#/definitions/nonNegative"},
        "idleRpm": {"$ref": "#/definitions/rpm"},
        "launchRpm": {"$ref": "#/definitions/rpm"},
        "engines": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/engine"}},
        "turbo": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["maxShaftRpm", "lagSec", "gain", "source"],
              "properties": {"maxShaftRpm": {"type": "integer", "minimum": 10000, "maximum": 300000}, "lagSec": {"$ref": "#/definitions/positive"}, "gain": {"$ref": "#/definitions/share"}, "source": {"$ref": "#/definitions/text"}}
            }
          ]
        },
        "electric": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "crankRatio", "gain", "source"],
              "properties": {"kind": {"enum": ["kers", "mguk", "mguk350"]}, "crankRatio": {"$ref": "#/definitions/positive"}, "gain": {"$ref": "#/definitions/share"}, "mguh": {"$ref": "#/definitions/share"}, "source": {"$ref": "#/definitions/text"}}
            }
          ]
        },
        "crackle": {"$ref": "#/definitions/share"},
        "notes": {"$ref": "#/definitions/text"}
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overtones", "halfOrder", "roughness", "brightness"],
      "properties": {
        "overtones": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/definitions/share"}},
        "halfOrder": {"$ref": "#/definitions/share"},
        "roughness": {"$ref": "#/definitions/share"},
        "brightness": {"$ref": "#/definitions/share"}
      }
    },
    "cameraMix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["listener", "up", "focus", "field", "interior", "crowd", "wind", "lowpassHz"],
      "properties": {
        "listener": {"enum": ["car", "post", "above"]},
        "useCamera": {"type": "boolean"},
        "back": {"type": "number"},
        "side": {"type": "number"},
        "up": {"type": "number"},
        "ahead": {"$ref": "#/definitions/positive"},
        "passBehind": {"$ref": "#/definitions/positive"},
        "focus": {"$ref": "#/definitions/share"},
        "field": {"$ref": "#/definitions/share"},
        "interior": {"$ref": "#/definitions/share"},
        "crowd": {"$ref": "#/definitions/share"},
        "wind": {"$ref": "#/definitions/share"},
        "bed": {"$ref": "#/definitions/share"},
        "lowpassHz": {"$ref": "#/definitions/positive"}
      }
    },
    "viewSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engineDb", "bedDb"],
      "properties": {
        "focus": {"$ref": "#/definitions/share"},
        "field": {"$ref": "#/definitions/share"},
        "interior": {"$ref": "#/definitions/share"},
        "crowd": {"$ref": "#/definitions/share"},
        "wind": {"$ref": "#/definitions/share"},
        "bed": {"$ref": "#/definitions/share"},
        "lowpassHz": {"$ref": "#/definitions/positive"},
        "ffBed": {"$ref": "#/definitions/share"},
        "engineDb": {"type": "number", "minimum": -60, "maximum": 6},
        "bedDb": {"type": "number", "minimum": -60, "maximum": 6}
      }
    }
  },
  "properties": {
    "$comment": {"type": "string"},
    "version": {"const": 1},
    "sources": {"type": "object", "additionalProperties": {"$ref": "#/definitions/text"}},
    "eras": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/era"}},
    "shiftProfiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/shiftProfile"}},
    "voicing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxHarmonics", "byCylinders", "layoutHalfOrder", "turboMuffle", "noise", "filter", "load", "downshiftShare", "launchShare", "limiterHz", "limiterDepth", "downshift", "pitLimiter", "crackleRatePerSec", "crackleGain", "smoothingSec"],
      "properties": {
        "$comment": {"type": "string"},
        "maxHarmonics": {"type": "integer", "minimum": 8, "maximum": 256},
        "byCylinders": {"type": "object", "propertyNames": {"pattern": "^[0-9]+$"}, "additionalProperties": {"$ref": "#/definitions/voice"}},
        "layoutHalfOrder": {
          "type": "object",
          "additionalProperties": false,
          "required": ["V", "F", "W", "L"],
          "properties": {"$comment": {"type": "string"}, "V": {"$ref": "#/definitions/positive"}, "F": {"$ref": "#/definitions/positive"}, "W": {"$ref": "#/definitions/positive"}, "L": {"$ref": "#/definitions/positive"}}
        },
        "turboMuffle": {"$ref": "#/definitions/share"},
        "noise": {
          "type": "object",
          "additionalProperties": false,
          "required": ["intakeGain", "exhaustGain", "bandQ", "exhaustOrder", "intakeOrder"],
          "properties": {"intakeGain": {"$ref": "#/definitions/share"}, "exhaustGain": {"$ref": "#/definitions/share"}, "bandQ": {"$ref": "#/definitions/positive"}, "exhaustOrder": {"$ref": "#/definitions/positive"}, "intakeOrder": {"$ref": "#/definitions/positive"}}
        },
        "filter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minHz", "maxHz", "q"],
          "properties": {"minHz": {"$ref": "#/definitions/positive"}, "maxHz": {"$ref": "#/definitions/positive"}, "q": {"$ref": "#/definitions/positive"}}
        },
        "load": {
          "type": "object",
          "additionalProperties": false,
          "required": ["offAccel", "onAccel", "overrunGain"],
          "properties": {"$comment": {"type": "string"}, "offAccel": {"type": "number", "maximum": 0}, "onAccel": {"type": "number"}, "overrunGain": {"$ref": "#/definitions/share"}, "easeSec": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "easeNote": {"type": "string"}}
        },
        "downshiftShare": {"$ref": "#/definitions/share"},
        "launchShare": {"$ref": "#/definitions/share"},
        "limiterHz": {"$ref": "#/definitions/positive"},
        "limiterDepth": {"$ref": "#/definitions/share"},
        "downshift": {
          "type": "object",
          "additionalProperties": false,
          "required": ["blipPct", "blipMs", "blipGainDb", "minSpacingSec", "source"],
          "properties": {
            "$comment": {"type": "string"},
            "blipPct": {"type": "number", "minimum": 0, "maximum": 0.5},
            "blipMs": {"type": "number", "exclusiveMinimum": 0, "maximum": 500},
            "blipGainDb": {"type": "number", "minimum": 0, "maximum": 12},
            "minSpacingSec": {"type": "number", "minimum": 0, "maximum": 2},
            "source": {"$ref": "#/definitions/text"}
          }
        },
        "pitLimiter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["flutterHz", "flutterDepth", "holdTolerance", "source"],
          "properties": {
            "$comment": {"type": "string"},
            "flutterHz": {"$ref": "#/definitions/positive"},
            "flutterDepth": {"type": "number", "minimum": 0, "maximum": 0.05},
            "holdTolerance": {"type": "number", "minimum": 0, "maximum": 0.5},
            "source": {"$ref": "#/definitions/text"}
          }
        },
        "gearHoldSec": {"type": "number", "minimum": 0, "maximum": 0.5}, "gearHoldNote": {"type": "string"}, "crackleRatePerSec": {"$ref": "#/definitions/positive"},
        "crackleGain": {"$ref": "#/definitions/share"},
        "smoothingSec": {"$ref": "#/definitions/positive"}
      }
    },
    "ui": {
      "$comment": "Sonidos de interfaz y «radio» sin voz (radio-ui-sounds, AUD-4; RF-CMD-03, RNF-07). Los rangos de duración son los de F1M24-GAMEPLAY §2.1 (clic 5-30 ms, whoosh 0,4-0,7 s); la radio, desde AUD-C3, en banda ancha (F1M24-CHINA §2.7).",
      "type": "object",
      "additionalProperties": false,
      "required": ["maxPerFrame", "cueSpacingSec", "click", "whoosh", "alert", "radio"],
      "properties": {
        "$comment": {"type": "string"},
        "maxPerFrame": {"type": "integer", "minimum": 1, "maximum": 4},
        "cueSpacingSec": {"$ref": "#/definitions/nonNegative"},
        "click": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selector", "durationSec", "noiseHz", "noiseGain", "toneHz", "toneGain", "cooldownSec"],
          "properties": {
            "$comment": {"type": "string"},
            "selector": {"$ref": "#/definitions/text"},
            "durationSec": {"type": "number", "minimum": 0.005, "maximum": 0.03},
            "noiseHz": {"$ref": "#/definitions/positive"},
            "noiseGain": {"$ref": "#/definitions/share"},
            "toneHz": {"$ref": "#/definitions/positive"},
            "toneGain": {"$ref": "#/definitions/share"},
            "cooldownSec": {"$ref": "#/definitions/nonNegative"}
          }
        },
        "whoosh": {
          "type": "object",
          "additionalProperties": false,
          "required": ["durationSec", "fromHz", "toHz", "q", "attackShare", "gain", "cooldownSec", "on"],
          "properties": {
            "$comment": {"type": "string"},
            "durationSec": {"type": "number", "minimum": 0.4, "maximum": 0.7},
            "fromHz": {"$ref": "#/definitions/positive"},
            "toHz": {"$ref": "#/definitions/positive"},
            "q": {"$ref": "#/definitions/positive"},
            "attackShare": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
            "gain": {"$ref": "#/definitions/share"},
            "cooldownSec": {"$ref": "#/definitions/nonNegative"},
            "on": {
              "type": "object",
              "additionalProperties": false,
              "required": ["replay", "skip"],
              "properties": {"replay": {"type": "boolean"}, "skip": {"type": "boolean"}}
            }
          }
        },
        "alert": {
          "type": "object",
          "additionalProperties": false,
          "required": ["steps", "stepSec", "toneSec", "attackSec", "gain", "cooldownSec", "levels", "events"],
          "properties": {
            "$comment": {"type": "string"},
            "steps": {
              "type": "array",
              "minItems": 2,
              "items": {"type": "object", "additionalProperties": false, "required": ["hz"], "properties": {"hz": {"$ref": "#/definitions/positive"}}}
            },
            "stepSec": {"$ref": "#/definitions/positive"},
            "toneSec": {"$ref": "#/definitions/positive"},
            "attackSec": {"$ref": "#/definitions/positive"},
            "gain": {"$ref": "#/definitions/share"},
            "cooldownSec": {"$ref": "#/definitions/nonNegative"},
            "levels": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["steps", "rank"],
                "properties": {"steps": {"type": "integer", "minimum": 1}, "rank": {"type": "integer", "minimum": 1}}
              }
            },
            "events": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
          }
        },
        "radio": {
          "$comment": "AUD-C3: secuencia whoosh → motivo → hueco → estática → cierre, banda ancha (≥ 4 kHz de ancho, nunca la telefónica) y paneo hacia el panel del piloto.",
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "band", "sequence", "pan", "attackSec", "cooldownSec"],
          "properties": {
            "$comment": {"type": "string"},
            "status": {"enum": ["NV", "pending", "sourced", "measured"]},
            "band": {
              "type": "object",
              "additionalProperties": false,
              "required": ["lowHz", "highHz"],
              "properties": {"lowHz": {"type": "number", "minimum": 80, "maximum": 400}, "highHz": {"type": "number", "minimum": 4500, "maximum": 8000}}
            },
            "sequence": {
              "type": "object",
              "additionalProperties": false,
              "required": ["whoosh", "motif", "gapSec", "static", "tail"],
              "properties": {
                "whoosh": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["durationSec", "fromHz", "toHz", "q", "attackShare", "gain"],
                  "properties": {"durationSec": {"type": "number", "minimum": 0.1, "maximum": 0.8}, "fromHz": {"$ref": "#/definitions/positive"}, "toHz": {"$ref": "#/definitions/positive"}, "q": {"$ref": "#/definitions/positive"}, "attackShare": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}, "gain": {"$ref": "#/definitions/share"}}
                },
                "motif": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["notes", "noteSec", "spacingSec", "gain"],
                  "properties": {
                    "notes": {"type": "array", "minItems": 2, "maxItems": 6, "items": {"type": "object", "additionalProperties": false, "required": ["hz"], "properties": {"hz": {"$ref": "#/definitions/positive"}}}},
                    "noteSec": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.3},
                    "spacingSec": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.3},
                    "gain": {"$ref": "#/definitions/share"}
                  }
                },
                "gapSec": {"type": "number", "minimum": 0, "maximum": 1.5},
                "static": {"type": "object", "additionalProperties": false, "required": ["durationSec", "gain"], "properties": {"durationSec": {"type": "number", "minimum": 0.1, "maximum": 1.5}, "gain": {"$ref": "#/definitions/share"}}},
                "tail": {"$ref": "#/definitions/uiTone"}
              }
            },
            "pan": {
              "type": "object",
              "additionalProperties": false,
              "required": ["byPanelSide", "db"],
              "properties": {"byPanelSide": {"type": "boolean"}, "db": {"type": "number", "minimum": 0, "maximum": 20}}
            },
            "attackSec": {"$ref": "#/definitions/positive"},
            "cooldownSec": {"$ref": "#/definitions/nonNegative"}
          }
        }
      }
    },
    "samples": {
      "$comment": "Motores grabados (three/audio/engineSamples.js, data/manager-sounds.json): reglas por año y motor hacia un banco; sin regla, sintetizado. Opcional: sin él todo suena sintetizado.",
      "type": "object",
      "additionalProperties": false,
      "required": ["enabledByDefault", "pitchFollow", "minRate", "maxRate", "load", "channels", "gain", "fadeSec", "releaseSec", "cars", "safetyCar"],
      "properties": {
        "$comment": {"type": "string"},
        "enabledByDefault": {"type": "boolean"},
        "enabledByDefaultNote": {"type": "string"},
        "pitchFollow": {"type": "number", "minimum": 0, "maximum": 1},
        "minRate": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "maxRate": {"type": "number", "minimum": 1, "maximum": 4},
        "load": {"type": "object", "additionalProperties": false, "required": ["decelBelow", "accelAbove"], "properties": {"$comment": {"type": "string"}, "decelBelow": {"$ref": "#/definitions/share"}, "accelAbove": {"$ref": "#/definitions/share"}}},
        "channels": {"type": "object", "additionalProperties": false, "required": ["engine", "exhaust", "interiorEngine", "interiorExhaust"], "properties": {"$comment": {"type": "string"}, "engine": {"$ref": "#/definitions/nonNegative"}, "exhaust": {"$ref": "#/definitions/nonNegative"}, "interiorEngine": {"$ref": "#/definitions/nonNegative"}, "interiorExhaust": {"$ref": "#/definitions/nonNegative"}}},
        "gain": {"type": "number", "minimum": 0, "maximum": 2},
        "fadeSec": {"$ref": "#/definitions/positive"},
        "releaseSec": {"$ref": "#/definitions/positive"},
        "cars": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "match", "bank"],
            "properties": {
              "from": {"type": "integer", "minimum": 1950, "maximum": 2100},
              "to": {"type": "integer", "minimum": 1950, "maximum": 2100},
              "match": {"type": "object", "additionalProperties": false, "properties": {"cylinders": {"type": "integer"}, "layout": {"enum": ["V", "F", "W", "L"]}, "aspiration": {"enum": ["na", "turbo", "hybrid"]}, "engineId": {"type": "string"}, "manufacturer": {"type": "string"}}},
              "bank": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}]},
              "note": {"type": "string"}
            }
          }
        },
        "safetyCar": {"type": "object", "properties": {"$comment": {"type": "string"}}, "additionalProperties": {"type": "string", "minLength": 1}}
      }
    },
    "mixer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storageKey", "defaults", "volumeCurve", "maxVoices", "panningModel", "distance", "doppler", "masterLimiter", "loudness", "cameras", "views"],
      "properties": {
        "storageKey": {"$ref": "#/definitions/text"},
        "settingsVersion": {"type": "integer", "minimum": 1},
        "settingsVersionNote": {"type": "string"},
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "required": ["master", "engine", "ambience", "muted", "ui", "uiMuted"],
          "properties": {"master": {"$ref": "#/definitions/share"}, "engine": {"$ref": "#/definitions/share"}, "ambience": {"$ref": "#/definitions/share"}, "muted": {"type": "boolean"}, "ui": {"$ref": "#/definitions/share"}, "uiMuted": {"type": "boolean"}, "recorded": {"type": "boolean"}}
        },
        "volumeCurve": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minDb"],
          "properties": {"$comment": {"type": "string"}, "minDb": {"type": "number", "maximum": -6}}
        },
        "maxVoices": {"type": "integer", "minimum": 1, "maximum": 22},
        "panningModel": {"enum": ["equalpower", "HRTF"]},
        "distance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "refDistance", "rolloff", "maxDistance", "audibleGain"],
          "properties": {"$comment": {"type": "string"}, "model": {"const": "inverse"}, "refDistance": {"$ref": "#/definitions/positive"}, "rolloff": {"$ref": "#/definitions/positive"}, "maxDistance": {"$ref": "#/definitions/positive"}, "audibleGain": {"$ref": "#/definitions/share"}}
        },
        "doppler": {
          "type": "object",
          "additionalProperties": false,
          "required": ["speedOfSound", "minFactor", "maxFactor", "source"],
          "properties": {"speedOfSound": {"$ref": "#/definitions/positive"}, "minFactor": {"$ref": "#/definitions/positive"}, "maxFactor": {"$ref": "#/definitions/positive"}, "source": {"$ref": "#/definitions/text"}}
        },
        "masterLimiter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["threshold", "knee", "ratio"],
          "properties": {"threshold": {"type": "number", "maximum": 0}, "knee": {"$ref": "#/definitions/nonNegative"}, "ratio": {"type": "number", "minimum": 1}}
        },
        "loudness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "onboardTargetDbfs", "tolerance", "measuredOnboardDbfs", "source", "makeupDb"],
          "properties": {
            "$comment": {"type": "string"},
            "status": {"enum": ["NV", "pending", "sourced", "measured"]},
            "onboardTargetDbfs": {"type": "number", "minimum": -40, "maximum": -6},
            "tolerance": {"type": "number", "exclusiveMinimum": 0, "maximum": 6},
            "measuredOnboardDbfs": {"type": "number", "minimum": -80, "maximum": 0},
            "source": {"$ref": "#/definitions/text"},
            "makeupDb": {"type": "number", "minimum": -12, "maximum": 20}
          }
        },
        "cameras": {
          "type": "object",
          "additionalProperties": false,
          "required": ["groups", "mix"],
          "properties": {
            "$comment": {"type": "string"},
            "groups": {"type": "object", "additionalProperties": {"type": "array", "items": {"$ref": "#/definitions/text"}}},
            "mix": {"type": "object", "additionalProperties": {"$ref": "#/definitions/cameraMix"}}
          }
        },
        "views": {
          "type": "object",
          "additionalProperties": false,
          "required": ["crossfadeMs", "snapshotFadeMs", "byGroup", "cameraListener", "snapshots"],
          "properties": {
            "$comment": {"type": "string"},
