{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "RNF-07: esquema completo de data/balance/broadcast.json (realización de TV, RF-3D-04, RNF-09). Lo crea CAM-1 con todas las claves que leerán CAM-2..5 y HUD; CAM-3 añade pitRig, las secuencias de boxes y garaje, el bloque replay completo y viewSafety. Lo comprueba components/director/directorState.test.js.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sources", "director", "views", "cycleOrder", "defaultView", "rigTemplate", "framing", "zonesPolicy", "pitRig", "scriptRig", "sequences", "replay", "viewSafety", "inserts", "scLights", "scView"],
  "definitions": {
    "text": {"type": "string", "minLength": 1},
    "status": {"enum": ["current", "pending", "sourced"]},
    "secOrNull": {"oneOf": [{"type": "null"}, {"type": "number", "minimum": 0, "maximum": 600}]},
    "view": {"enum": ["map", "tv", "camera"]},
    "cameraId": {"type": "string", "pattern": "^[a-zA-Z]+$"},
    "scPhase": {"enum": ["DEPLOYED", "PICKUP", "TRAIN", "UNLAPPING", "IN_THIS_LAP", "RESTART"]},
    "hexColor": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "cam"],
      "properties": {
        "trigger": {"$ref": "#/definitions/text"},
        "cam": {"$ref": "#/definitions/text"},
        "subject": {"$ref": "#/definitions/text"},
        "minSec": {"type": "number", "minimum": 0},
        "maxSec": {"type": "number", "minimum": 0},
        "skippable": {"type": "boolean"},
        "lead": {"type": "boolean"},
        "during": {"type": "array", "items": {"enum": ["formation", "grid", "lights", "out"]}, "minItems": 1},
        "requires": {"enum": ["safetyCar", "vsc"]},
        "until": {"$ref": "#/definitions/text"}
      }
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "shots"],
      "properties": {
        "status": {"$ref": "#/definitions/status"},
        "note": {"type": "string"},
        "crewLeadSec": {"$ref": "#/definitions/secOrNull"},
        "finisherShots": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object", "additionalProperties": false, "required": ["minSec", "maxSec"],
              "properties": {
                "minSec": {"type": "number", "minimum": 0},
                "maxSec": {"type": "number", "minimum": 0},
                "cam": {"$ref": "#/definitions/cameraId"},
                "maxLagSec": {"type": "number", "minimum": 0, "maximum": 120},
                "idleEndSec": {"type": "number", "exclusiveMinimum": 0, "maximum": 600}
              }
            }
          ]
        },
        "skippable": {"type": "boolean"},
        "loop": {"type": "boolean"},
        "lateSec": {"type": "number", "minimum": 0, "maximum": 60},
        "shots": {"type": "array", "items": {"$ref": "#/definitions/shot"}}
      }
    },
    "rigType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "dist", "height", "width", "priority", "weight", "status"],
      "properties": {
        "type": {"enum": ["braking", "corner", "straight", "headOn", "passPan", "lateralTrack", "highWide", "grandstand", "cable"]},
        "dist": {"type": "number", "minimum": 0, "maximum": 500},
        "height": {"type": "number", "minimum": 0, "maximum": 200},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 500},
        "priority": {"type": "integer", "minimum": 0, "maximum": 10},
        "weight": {"type": "number", "minimum": 0},
        "offsetM": {"type": "number", "minimum": -500, "maximum": 500},
        "everyM": {"type": "number", "exclusiveMinimum": 0, "maximum": 2000},
        "lagM": {"type": "number", "minimum": 0, "maximum": 200},
        "spanM": {
          "type": "object", "additionalProperties": false, "required": ["from", "to"],
          "properties": {"from": {"type": "number", "minimum": -1000, "maximum": 1000}, "to": {"type": "number", "minimum": -1000, "maximum": 1000}}
        },
        "approach": {
          "type": "object", "additionalProperties": false, "required": ["maxShare", "ofStraight"],
          "properties": {"maxShare": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.5}, "ofStraight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}}
        },
        "byKind": {
          "type": "object", "additionalProperties": false, "required": ["slow", "medium", "fast"],
          "properties": {
            "slow": {"$ref": "#/definitions/placement"},
            "medium": {"$ref": "#/definitions/placement"},
            "fast": {"$ref": "#/definitions/placement"}
          }
        },
        "status": {"$ref": "#/definitions/status"},
        "note": {"type": "string"}
      }
    },
    "placement": {
      "type": "object", "additionalProperties": false, "required": ["dist", "height"],
      "properties": {"dist": {"type": "number", "minimum": 0, "maximum": 500}, "height": {"type": "number", "minimum": 0, "maximum": 200}}
    },
    "replayScope": {"enum": ["user", "rival", "leader", "any"]},
    "pitCam": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "anchor", "alongM", "side", "dist", "height", "width", "aim"],
      "properties": {
        "id": {"$ref": "#/definitions/cameraId"},
        "anchor": {"enum": ["entry", "limitFrom", "line", "limitTo", "exit", "box", "trackEntry", "trackExit"]},
        "alongM": {"type": "number", "minimum": -500, "maximum": 500},
        "side": {"enum": ["garage", "wall", "outside"]},
        "dist": {"type": "number", "minimum": 0, "maximum": 300},
        "height": {"type": "number", "minimum": 0, "maximum": 200},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 500},
        "aim": {"enum": ["car", "box"]}
      }
    },
    "scriptCam": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "anchor", "alongM", "sideM", "height", "width", "aim", "label"],
      "properties": {
        "id": {"$ref": "#/definitions/cameraId"},
        "anchor": {"enum": ["pole", "gridMid", "gridBack", "scParked", "line", "subject"]},
        "alongM": {"type": "number", "minimum": -500, "maximum": 500},
        "sideM": {"type": "number", "minimum": -200, "maximum": 200},
        "height": {"type": "number", "minimum": 0, "maximum": 200},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 500},
        "aim": {"enum": ["anchor", "subject", "gridMid"]},
        "label": {"type": "array", "items": {"$ref": "#/definitions/text"}, "minItems": 2, "maxItems": 2}
      }
    },
    "rigTypeName": {"enum": ["braking", "corner", "straight", "headOn", "passPan", "lateralTrack", "highWide", "grandstand", "cable"]},
    "framingType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minShare", "maxShare", "critDamp"],
      "properties": {
        "minShare": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "maxShare": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "critDamp": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  },
  "properties": {
    "$comment": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "sources": {"type": "object", "additionalProperties": {"$ref": "#/definitions/text"}},
    "director": {
      "type": "object",
      "additionalProperties": false,
      "required": ["battleGapSec", "battleStates", "followAction", "status", "source"],
      "properties": {
        "battleGapSec": {"type": "number", "exclusiveMinimum": 0, "maximum": 5},
        "battleStates": {"type": "array", "items": {"enum": ["RUNNING", "FOLLOWING", "ATTACKING", "DEFENDING", "TRAIN"]}, "minItems": 1, "uniqueItems": true},
        "followAction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "holdSec", "preferUser", "status", "note"],
          "properties": {
            "enabled": {"type": "boolean"},
            "holdSec": {"type": "number", "exclusiveMinimum": 0, "maximum": 120},
            "preferUser": {"type": "boolean"},
            "status": {"$ref": "#/definitions/status"},
            "note": {"$ref": "#/definitions/text"}
          }
        },
        "status": {"$ref": "#/definitions/status"},
        "source": {"$ref": "#/definitions/text"}
      }
    },
    "views": {"type": "array", "items": {"$ref": "#/definitions/view"}, "minItems": 1, "uniqueItems": true},
    "cycleOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cameras", "status"],
      "properties": {
        "cameras": {"type": "array", "items": {"$ref": "#/definitions/cameraId"}, "minItems": 1, "uniqueItems": true},
        "status": {"$ref": "#/definitions/status"},
        "note": {"type": "string"}
      }
    },
    "defaultView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["race", "sprint", "qualifying", "practice", "status"],
      "properties": {
        "race": {"$ref": "#/definitions/view"},
        "sprint": {"$ref": "#/definitions/view"},
        "qualifying": {"$ref": "#/definitions/view"},
        "practice": {"$ref": "#/definitions/view"},
        "status": {"$ref": "#/definitions/status"},
        "note": {"type": "string"}
      }
    },
    "rigTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "types"],
      "properties": {
        "status": {"$ref": "#/definitions/status"},
        "note": {"type": "string"},
        "carLengthM": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
        "carLengthNote": {"type": "string"},
        "types": {"type": "array", "items": {"$ref": "#/definitions/rigType"}, "minItems": 1}
      }
    },
    "framing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "byType"],
      "properties": {
        "status": {"$ref": "#/definitions/status"},
        "note": {"type": "string"},
        "fovDeg": {
          "type": "object", "additionalProperties": false, "required": ["min", "max"],
          "properties": {"min": {"type": "number", "exclusiveMinimum": 0, "maximum": 120}, "max": {"type": "number", "exclusiveMinimum": 0, "maximum": 120}}
        },
        "lookAhead": {
          "type": "object", "additionalProperties": false, "required": ["perSpeed", "maxM"],
          "properties": {"perSpeed": {"type": "number", "minimum": 0, "maximum": 1}, "maxM": {"type": "number", "minimum": 0, "maximum": 50}}
        },
        "aimUpM": {"type": "number", "minimum": 0, "maximum": 3},
        "byType": {"type": "object", "additionalProperties": {"$ref": "#/definitions/framingType"}},
        "battle": {
          "type": "object", "additionalProperties": false, "required": ["pairShare", "maxGapM"],
          "properties": {
            "pairShare": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "maxGapM": {"type": "number", "exclusiveMinimum": 0, "maximum": 500},
            "note": {"type": "string"}
          }
        }
      }
    },
    "zonesPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["avoidRepeat", "seedSalt", "status"],
      "properties": {
        "avoidRepeat": {"type": "boolean"},
        "seedSalt": {"$ref": "#/definitions/text"},
        "status": {"$ref": "#/definitions/status"},
        "note": {"type": "string"},
        "layout": {
          "type": "object", "additionalProperties": false,
          "required": ["cornerEntryM", "cornerExitM", "chicaneGapM", "straightMaxM", "minZoneM"],
          "properties": {
            "cornerEntryM": {"type": "number", "minimum": 0, "maximum": 300},
            "cornerExitM": {"type": "number", "minimum": 0, "maximum": 300},
            "chicaneGapM": {"type": "number", "minimum": 0, "maximum": 300},
            "straightMaxM": {"type": "number", "exclusiveMinimum": 0, "maximum": 3000},
            "minZoneM": {"type": "number", "minimum": 0, "maximum": 500}
          }
        },
        "cams": {
          "type": "object", "additionalProperties": false, "required": ["corner", "braking", "straight", "line"],
          "properties": {
            "corner": {"type": "array", "items": {"$ref": "#/definitions/rigTypeName"}, "minItems": 1, "maxItems": 3, "uniqueItems": true},
            "braking": {"type": "array", "items": {"$ref": "#/definitions/rigTypeName"}, "minItems": 1, "maxItems": 3, "uniqueItems": true},
            "straight": {"type": "array", "items": {"$ref": "#/definitions/rigTypeName"}, "minItems": 1, "maxItems": 3, "uniqueItems": true},
            "line": {"type": "array", "items": {"$ref": "#/definitions/rigTypeName"}, "minItems": 1, "maxItems": 3, "uniqueItems": true}
          }
        },
        "looseRadiusM": {"type": "number", "exclusiveMinimum": 0, "maximum": 2000},
        "nearRadiusM": {"type": "number", "exclusiveMinimum": 0, "maximum": 5000}
      }
    },
    "pitRig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "cams", "fovDeg", "critDamp"],
      "properties": {
        "status": {"$ref": "#/definitions/status"},
        "note": {"type": "string"},
        "cams": {"type": "array", "items": {"$ref": "#/definitions/pitCam"}, "minItems": 1},
        "fovDeg": {
          "type": "object", "additionalProperties": false, "required": ["min", "max"],
          "properties": {"min": {"type": "number", "exclusiveMinimum": 0, "maximum": 120}, "max": {"type": "number", "exclusiveMinimum": 0, "maximum": 120}}
        },
        "critDamp": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "scriptRig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "scParkedBackM", "cams", "fovDeg", "critDamp"],
      "properties": {
        "status": {"$ref": "#/definitions/status"},
        "note": {"type": "string"},
        "scParkedBackM": {"type": "number", "minimum": 0, "maximum": 200},
        "cams": {"type": "array", "items": {"$ref": "#/definitions/scriptCam"}, "minItems": 1},
        "fovDeg": {
          "type": "object", "additionalProperties": false, "required": ["min", "max"],
          "properties": {"min": {"type": "number", "exclusiveMinimum": 0, "maximum": 120}, "max": {"type": "number", "exclusiveMinimum": 0, "maximum": 120}}
        },
        "critDamp": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "viewSafety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overlap", "quickReplay"],
      "properties": {
        "overlap": {
          "type": "object", "additionalProperties": false, "required": ["toleranceMetres", "maxPushMetres", "passes", "status"],
          "properties": {
            "toleranceMetres": {"type": "number", "minimum": 0, "maximum": 1},
            "maxPushMetres": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
            "passes": {"type": "integer", "minimum": 1, "maximum": 10},
            "status": {"$ref": "#/definitions/status"},
            "note": {"type": "string"}
          }
        },
        "quickReplay": {
          "type": "object", "additionalProperties": false, "required": ["wakeMetres", "pullOutMetres", "status"],
          "properties": {
            "wakeMetres": {"type": "number", "exclusiveMinimum": 0, "maximum": 50},
            "pullOutMetres": {"type": "number", "minimum": 0, "maximum": 10},
            "status": {"$ref": "#/definitions/status"},
            "note": {"type": "string"}
          }
        }
      }
    },
    "sequences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pitStop", "garageExit", "preRace", "start", "finish", "scDeploy"],
      "properties": {
        "pitStop": {"$ref": "#/definitions/sequence"},
        "garageExit": {"$ref": "#/definitions/sequence"},
        "preRace": {"$ref": "#/definitions/sequence"},
        "start": {"$ref": "#/definitions/sequence"},
        "finish": {"$ref": "#/definitions/sequence"},
        "scDeploy": {"$ref": "#/definitions/sequence"}
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bufferSec", "sampleHz", "stingSec", "maxSec", "preSec", "postSec", "angles", "onboard", "closeUp", "cooldownSec", "queueMax", "pauseSim", "triggers", "scope", "status"],
      "properties": {
        "bufferSec": {"type": "number", "exclusiveMinimum": 0, "maximum": 120},
        "sampleHz": {"type": "number", "exclusiveMinimum": 0, "maximum": 60},
        "stingSec": {"$ref": "#/definitions/secOrNull"},
        "maxSec": {"$ref": "#/definitions/secOrNull"},
        "preSec": {"type": "number", "minimum": 0, "maximum": 120},
        "postSec": {"type": "number", "minimum": 0, "maximum": 60},
        "angles": {
          "type": "object", "additionalProperties": false, "required": ["min", "max", "minSec"],
          "properties": {
            "min": {"type": "integer", "minimum": 1, "maximum": 6},
            "max": {"type": "integer", "minimum": 1, "maximum": 6},
            "minSec": {"type": "number", "exclusiveMinimum": 0, "maximum": 60}
          }
        },
        "onboard": {"oneOf": [{"type": "null"}, {"$ref": "#/definitions/cameraId"}]},
        "closeUp": {"oneOf": [{"type": "null"}, {"$ref": "#/definitions/cameraId"}]},
        "cooldownSec": {"type": "number", "minimum": 0, "maximum": 600},
        "queueMax": {"type": "integer", "minimum": 1, "maximum": 20},
        "scope": {
          "type": "object", "additionalProperties": false, "required": ["pass", "mistake", "dnf", "pitOther", "finish"],
          "properties": {
            "pass": {"$ref": "#/definitions/replayScope"}, "mistake": {"$ref": "#/definitions/replayScope"}, "dnf": {"$ref": "#/definitions/replayScope"},
            "pitOther": {"$ref": "#/definitions/replayScope"}, "finish": {"$ref": "#/definitions/replayScope"}
          }
        },
        "pauseSim": {"type": "boolean"},
        "triggers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pass", "mistake", "dnf", "pitOther", "finish"],
          "properties": {
            "pass": {"type": "boolean"}, "mistake": {"type": "boolean"}, "dnf": {"type": "boolean"},
            "pitOther": {"type": "boolean"}, "finish": {"type": "boolean"}
          }
        },
        "status": {"$ref": "#/definitions/status"},
        "note": {"type": "string"}
      }
    },
    "inserts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["onboard"],
      "properties": {
        "onboard": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "perLap", "minSec", "maxSec", "zoneKinds", "status"],
          "properties": {
            "enabled": {"type": "boolean"},
            "perLap": {"oneOf": [{"type": "null"}, {"type": "number", "minimum": 0, "maximum": 10}]},
            "minSec": {"$ref": "#/definitions/secOrNull"},
            "maxSec": {"$ref": "#/definitions/secOrNull"},
            "zoneKinds": {"type": "array", "items": {"enum": ["corner", "braking", "straight", "line"]}, "minItems": 1},
            "cam": {"$ref": "#/definitions/cameraId"},
            "seedSalt": {"$ref": "#/definitions/text"},
            "status": {"$ref": "#/definitions/status"},
            "note": {"type": "string"}
          }
        }
      }
    },
    "scLights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flashHz", "pattern", "dutyCycle", "offLevel", "status"],
      "properties": {
        "flashHz": {"oneOf": [{"type": "null"}, {"type": "number", "minimum": 0, "maximum": 20}]},
        "pattern": {"enum": ["alternate", "together"]},
        "dutyCycle": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "offLevel": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"$ref": "#/definitions/status"},
        "note": {"type": "string"}
      }
    },
    "scView": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "drawPhases", "lightsOffPhases", "pitCamMaxM", "model"],
      "properties": {
        "status": {"$ref": "#/definitions/status"},
        "note": {"type": "string"},
        "drawPhases": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/scPhase"}},
        "lightsOffPhases": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/scPhase"}},
        "pitCamMaxM": {"type": "number", "exclusiveMinimum": 0, "maximum": 5000},
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["paint", "dark", "lightOn", "lightBase", "lightOff", "emissiveOn"],
          "properties": {
            "paint": {"$ref": "#/definitions/hexColor"},
            "dark": {"$ref": "#/definitions/hexColor"},
            "lightOn": {"$ref": "#/definitions/hexColor"},
            "lightBase": {"$ref": "#/definitions/hexColor"},
            "lightOff": {"$ref": "#/definitions/hexColor"},
            "emissiveOn": {"type": "number", "minimum": 0, "maximum": 10}
          }
        }
      }
    }
  }
}
