{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "RNF-07: esquema de data/balance/live-view.json (reproducción en directo: velocidades, auto-velocidad, pausa, siguiente evento, vistas y cámaras; RF-CMD-04, RF-3D-04, RNF-05). Lo comprueba components/playback.test.js.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$comment", "version", "speeds", "defaultSpeed", "engineLead", "autoSpeed", "eventPriority", "triggers", "pauseOn", "nextEvent", "views", "start", "finish", "replay", "continuity", "fastForward"],
  "definitions": {
    "status": { "enum": ["srs", "behaviour", "pending", "measured", "NV"] },
    "speed": { "enum": [1, 2, 4, 8, 16] },
    "sessionKinds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["race", "raceReplay", "practice", "qualifying", "shootout"],
      "properties": {
        "race": { "$ref": "#/definitions/view" },
        "raceReplay": { "$ref": "#/definitions/view" },
        "practice": { "$ref": "#/definitions/view" },
        "qualifying": { "$ref": "#/definitions/view" },
        "shootout": { "$ref": "#/definitions/view" }
      }
    },
    "view": { "enum": ["map", "tv", "camera"] },
    "triggerMap": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "typeList": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "cameraList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  },
  "properties": {
    "$comment": { "type": "string" },
    "version": { "const": 1 },
    "speeds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$comment", "status", "list"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "list": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/speed" } }
      }
    },
    "defaultSpeed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$comment", "status", "race", "raceReplay", "practice", "qualifying", "shootout"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "race": { "$ref": "#/definitions/speed" },
        "raceReplay": { "$ref": "#/definitions/speed" },
        "practice": { "$ref": "#/definitions/speed" },
        "qualifying": { "$ref": "#/definitions/speed" },
        "shootout": { "$ref": "#/definitions/speed" }
      }
    },
    "engineLead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$comment", "status", "minChunkSec", "chunkPerSpeedSec"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "minChunkSec": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
        "chunkPerSpeedSec": { "type": "number", "exclusiveMinimum": 0, "maximum": 2 }
      }
    },
    "autoSpeed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$comment", "status", "enabledByDefault", "levels", "rampRealSec", "restoreAfter"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "enabledByDefault": { "type": "boolean" },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["minPriority", "speed"],
            "properties": {
              "minPriority": { "type": "integer", "minimum": 1, "maximum": 9 },
              "speed": { "$ref": "#/definitions/speed" }
            }
          }
        },
        "rampRealSec": { "type": "number", "minimum": 0, "maximum": 5 },
        "restoreAfter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "simSec"],
          "properties": {
            "enabled": { "type": "boolean" },
            "simSec": { "type": "number", "exclusiveMinimum": 0, "maximum": 600 }
          }
        }
      }
    },
    "eventPriority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$comment", "status", "map"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "map": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 9 } }
      }
    },
    "triggers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$comment", "status", "raceEvents", "ownRaceEvents", "sessionEvents", "ownSessionEvents", "ownSessionPhases", "ownPitEntry"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "raceEvents": { "$ref": "#/definitions/triggerMap" },
        "ownRaceEvents": { "$ref": "#/definitions/triggerMap" },
        "sessionEvents": { "$ref": "#/definitions/triggerMap" },
        "ownSessionEvents": { "$ref": "#/definitions/triggerMap" },
        "ownSessionPhases": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": { "^(garage|queued|out|flying|cool|in|pitlane)$": { "type": "string", "minLength": 1 } }
        },
        "ownPitEntry": { "type": "string", "minLength": 1 }
      }
    },
    "pauseOn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$comment", "status", "list"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "list": { "type": "array", "uniqueItems": true, "items": { "enum": ["pitDialog", "setupDialog", "replay"] } }
      }
    },
    "nextEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$comment", "status", "race", "session", "ownSession", "maxSimSec"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "race": { "$ref": "#/definitions/typeList" },
        "session": { "$ref": "#/definitions/typeList" },
        "ownSession": { "$ref": "#/definitions/typeList" },
        "maxSimSec": { "type": "number", "exclusiveMinimum": 0, "maximum": 86400 }
      }
    },
    "views": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$comment", "status", "list", "defaultView", "cameras", "defaultCamera", "camerasByEra", "ring", "mirror"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "list": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/view" } },
        "defaultView": {
          "type": "object",
          "additionalProperties": false,
          "required": ["with3D", "without3D"],
          "properties": { "with3D": { "$ref": "#/definitions/sessionKinds" }, "without3D": { "$ref": "#/definitions/sessionKinds" } }
        },
        "cameras": {
          "type": "object",
          "additionalProperties": false,
          "required": ["with3D", "without3D"],
          "properties": { "with3D": { "$ref": "#/definitions/cameraList" }, "without3D": { "$ref": "#/definitions/cameraList" } }
        },
        "defaultCamera": {
          "type": "object",
          "additionalProperties": false,
          "required": ["with3D", "without3D"],
          "properties": { "with3D": { "type": "string" }, "without3D": { "type": "string" } }
        },
        "camerasByEra": {
          "type": "object",
          "additionalProperties": false,
          "required": ["$comment", "status", "list"],
          "properties": {
            "$comment": { "type": "string" },
            "status": { "$ref": "#/definitions/status" },
            "list": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["from", "to", "with3D", "source", "status"],
                "properties": {
                  "from": { "type": "integer", "minimum": 1950, "maximum": 2100 },
                  "to": { "type": "integer", "minimum": 1950, "maximum": 2100 },
                  "with3D": { "$ref": "#/definitions/cameraList" },
                  "source": { "type": "string", "minLength": 1 },
                  "status": { "$ref": "#/definitions/status" }
                }
              }
            },
            "$status": { "type": "string" }
          }
        },
        "ring": {
          "type": "object",
          "additionalProperties": false,
          "required": ["$comment", "status", "order", "segments", "keepTypeOnFocus"],
          "properties": {
            "$comment": { "type": "string" },
            "status": { "$ref": "#/definitions/status" },
            "order": { "const": "broadcast.json cycleOrder.cameras" },
            "segments": {
              "type": "object",
              "additionalProperties": false,
              "required": ["exterior", "onboard"],
              "properties": {
                "exterior": { "$ref": "#/definitions/cameraList" },
                "onboard": { "const": "cameras.json onboard" }
              }
            },
            "keepTypeOnFocus": { "type": "boolean" }
          }
        },
        "mirror": {
          "type": "object",
          "additionalProperties": false,
          "required": ["$comment", "status", "enabled", "camera", "key"],
          "properties": {
            "$comment": { "type": "string" },
            "status": { "$ref": "#/definitions/status" },
            "enabled": { "type": "boolean" },
            "camera": { "type": "string", "minLength": 1 },
            "key": { "type": "string", "minLength": 1, "maxLength": 12 }
          }
        }
      }
    },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$comment", "status", "preStart", "formation", "lightsSpeed"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "preStart": { "type": "boolean" },
        "formation": { "enum": ["skip", "drive"] },
        "lightsSpeed": { "anyOf": [{ "$ref": "#/definitions/speed" }, { "type": "null" }] }
      }
    },
    "finish": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$comment", "status", "afterLastSec", "handBackRealMs", "cooldown"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "afterLastSec": { "type": "number", "minimum": 0, "maximum": 600 },
        "handBackRealMs": { "type": "number", "minimum": 0, "maximum": 60000 },
        "cooldown": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "enabled"],
          "properties": { "status": { "$ref": "#/definitions/status" }, "enabled": { "type": "boolean" } }
        }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$comment", "status", "auto", "autoViews"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "auto": { "type": "boolean" },
        "autoViews": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/view" } }
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$comment", "status", "enabled", "k", "marginM", "fallbackSpeedFactor"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "enabled": { "type": "boolean" },
        "k": { "type": "number", "minimum": 1, "maximum": 3 },
        "marginM": { "type": "number", "minimum": 0, "maximum": 20 },
        "fallbackSpeedFactor": { "type": "number", "minimum": 1, "maximum": 4 }
      }
    },
    "fastForward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$comment", "status", "enabled", "mapAtSpeed", "restoreCamera"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "enabled": { "type": "boolean" },
        "mapAtSpeed": { "$ref": "#/definitions/speed" },
        "restoreCamera": { "type": "boolean" },
        "$userToggle": { "type": "string" },
        "userToggle": { "type": "boolean" }
      }
    }
  }
}
