{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "RNF-07: esquema de data/balance/sessions.json (sesiones jugables: RF-WKD-01/02/03/05, RF-SIM-11, RF-SIM-15). Lo comprueba engine/sessionSim/session.test.js. Las tablas por año llevan status: source (con cita del reglamento), measured (calibrado contra datos) o pending (de memoria o NV).",
  "type": "object",
  "required": ["$comment", "version", "step", "laps", "garage", "evolution", "pace", "programmes", "limits", "durations", "allocation", "ai", "sprint", "clock", "yellow"],
  "definitions": {
    "shareByKind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["practice", "qualifying", "shootout"],
      "properties": {
        "practice": { "type": "number", "minimum": 0, "maximum": 1 },
        "qualifying": { "type": "number", "minimum": 0, "maximum": 1 },
        "shootout": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "spread": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p10", "median", "p90"],
      "properties": {
        "n": { "type": "integer", "minimum": 1 },
        "p10": { "type": "number", "exclusiveMinimum": 0 },
        "median": { "type": "number", "exclusiveMinimum": 0 },
        "p90": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "episodes": {
      "type": "object",
      "required": ["sessions", "episodes", "perSession", "doubleShare"],
      "properties": {
        "sessions": { "type": "integer", "minimum": 1 },
        "episodes": { "type": "integer", "minimum": 0 },
        "perSession": { "type": "number", "minimum": 0 },
        "doubleShare": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "year": { "type": "integer", "minimum": 1950, "maximum": 2030 },
    "nonNegative": { "type": "number", "minimum": 0 },
    "positive": { "type": "number", "exclusiveMinimum": 0 },
    "status": { "enum": ["source", "measured", "pending"] },
    "source": {
      "type": "object",
      "required": ["url", "quote"],
      "properties": { "url": { "type": "string", "pattern": "^https://" }, "quote": { "type": "string", "minLength": 10 } }
    },
    "yearRow": {
      "type": "object",
      "required": ["from", "to", "status"],
      "properties": {
        "from": { "$ref": "#/definitions/year" },
        "to": { "$ref": "#/definitions/year" },
        "status": { "$ref": "#/definitions/status" },
        "source": { "$ref": "#/definitions/source" },
        "note": { "type": "string" }
      },
      "if": { "properties": { "status": { "const": "source" } } },
      "then": { "required": ["source"] }
    },
    "minutesList": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/positive" } },
    "breaks": { "type": "array", "items": { "$ref": "#/definitions/nonNegative" } },
    "evolutionRow": {
      "type": "object",
      "required": ["perFieldLap", "max", "carryBetweenSegments", "status"],
      "properties": {
        "startSec": { "type": "number", "minimum": 0, "maximum": 5 },
        "perFieldLap": { "type": "number", "maximum": 0, "minimum": -0.05 },
        "max": { "type": "number", "maximum": 0, "minimum": -5 },
        "carryBetweenSegments": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "$ref": "#/definitions/status" }
      }
    }
  },
  "properties": {
    "$comment": { "type": "string" },
    "version": { "const": 1 },
    "step": { "type": "object", "required": ["dt"], "properties": { "dt": { "$ref": "#/definitions/positive" } } },
    "laps": {
      "type": "object",
      "required": ["outLap", "coolLap", "abortRest", "inLap", "burnLap"],
      "not": { "anyOf": [{ "required": ["pitLaneSec"] }, { "required": ["boxStopSec"] }] },
      "properties": {
        "outLap": { "type": "number", "minimum": 1 },
        "coolLap": { "type": "number", "minimum": 1 },
        "abortRest": { "type": "number", "minimum": 1 },
        "inLap": { "type": "number", "minimum": 1 },
        "burnLap": { "type": "number", "minimum": 1 }
      }
    },
    "garage": {
      "type": "object",
      "required": ["$comment", "status", "exit", "work"],
      "properties": {
        "status": { "$ref": "#/definitions/status" },
        "exit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["$comment", "status", "rollOutSec", "measured"],
          "properties": {
            "$comment": { "type": "string" },
            "status": { "$ref": "#/definitions/status" },
            "rollOutSec": { "type": "number", "minimum": 0, "maximum": 30 },
            "measured": {
              "type": "object",
              "required": ["source", "circuitId", "year", "n", "median", "p10", "p90"],
              "properties": {
                "source": { "type": "string", "minLength": 10 },
                "circuitId": { "type": "string" },
                "year": { "$ref": "#/definitions/year" },
                "n": { "type": "integer", "minimum": 1 },
                "median": { "$ref": "#/definitions/positive" },
                "p10": { "$ref": "#/definitions/positive" },
                "p90": { "$ref": "#/definitions/positive" }
              }
            }
          }
        },
        "work": {
          "type": "object",
          "additionalProperties": false,
          "required": ["baseSec", "tyreSec", "fuelPerLapSec", "setup", "crewRef", "crewPerPoint", "crewMin", "crewMax"],
          "properties": {
            "baseSec": { "$ref": "#/definitions/nonNegative" },
            "tyreSec": { "$ref": "#/definitions/nonNegative" },
            "fuelPerLapSec": { "$ref": "#/definitions/nonNegative" },
            "setup": {
              "type": "object",
              "additionalProperties": false,
              "required": ["baseSec", "perPoint"],
              "properties": { "baseSec": { "$ref": "#/definitions/nonNegative" }, "perPoint": { "$ref": "#/definitions/nonNegative" } }
            },
            "crewRef": { "type": "number", "minimum": 0, "maximum": 100 },
            "crewPerPoint": { "$ref": "#/definitions/nonNegative" },
            "crewMin": { "$ref": "#/definitions/positive" },
            "crewMax": { "$ref": "#/definitions/positive" }
          }
        }
      }
    },
    "evolution": {
      "type": "object",
      "required": ["$comment", "default", "byEra", "measured"],
      "properties": {
        "default": { "$ref": "#/definitions/evolutionRow" },
        "byEra": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [{ "$ref": "#/definitions/evolutionRow" }],
            "required": ["from", "to", "simYear"],
            "properties": { "from": { "$ref": "#/definitions/year" }, "to": { "$ref": "#/definitions/year" }, "simYear": { "$ref": "#/definitions/year" } }
          }
        },
        "measured": {
          "type": "object",
          "required": ["$comment"],
          "patternProperties": {
            "^[0-9]{4}-[0-9]{4}$": {
              "type": "object",
              "additionalProperties": false,
              "required": ["q1ToQ3", "q1ToQ2", "races"],
              "properties": { "q1ToQ3": { "type": "number" }, "q1ToQ2": { "type": "number" }, "races": { "type": "integer", "minimum": 1 } }
            }
          }
        }
      }
    },
    "pace": { "type": "object", "required": ["styles", "mistakeCost", "practiceOffset", "longRunOffset", "noiseScale", "sectorNoiseShare"] },
    "programmes": { "type": "object", "required": ["setup", "longrun", "quali"] },
    "limits": {
      "type": "object",
      "required": ["practiceLaps", "pushLaps", "fuelLaps", "burnLaps"],
      "properties": {
        "burnLaps": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0 } }
      }
    },
    "durations": {
      "type": "object",
      "required": ["practice", "knockout", "oneSession", "twoSession", "oneLap", "sprintShootout"],
      "properties": {
        "practice": { "type": "array", "items": { "allOf": [{ "$ref": "#/definitions/yearRow" }], "required": ["minutes"] } },
        "knockout": {
          "type": "array",
          "items": {
            "allOf": [{ "$ref": "#/definitions/yearRow" }],
            "required": ["minutes", "breakMinutes"],
            "properties": { "minutes": { "$ref": "#/definitions/minutesList" }, "breakMinutes": { "$ref": "#/definitions/breaks" }, "fuelBurnLast": { "type": "boolean" } }
          }
        },
        "sprintShootout": {
          "type": "array",
          "items": {
            "allOf": [{ "$ref": "#/definitions/yearRow" }],
            "required": ["minutes", "breakMinutes", "tyres"],
            "properties": { "minutes": { "$ref": "#/definitions/minutesList" }, "breakMinutes": { "$ref": "#/definitions/breaks" } }
          }
        },
        "oneSession": { "type": "array", "items": { "$ref": "#/definitions/yearRow" } },
        "twoSession": { "type": "array", "items": { "$ref": "#/definitions/yearRow" } },
        "oneLap": { "type": "array", "items": { "$ref": "#/definitions/yearRow" } }
      }
    },
    "allocation": { "type": "object", "required": ["byYear"] },
    "ai": {
      "type": "object",
      "required": ["practiceRuns", "qualiRuns", "lastSegmentRuns", "twoPushChance", "hourRuns", "fuelBurnShare"],
      "properties": { "fuelBurnShare": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 } }
    },
    "sprint": { "type": "object", "required": ["distanceKm"] },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$comment", "fallbackRaceStartHour", "templates", "diurnal"],
      "properties": {
        "$comment": { "type": "string" },
        "fallbackRaceStartHour": { "type": "number", "minimum": 0, "maximum": 24 },
        "templates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [{ "$ref": "#/definitions/yearRow" }],
            "required": ["sessions"],
            "properties": {
              "sessions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "name", "day", "offsetHours"],
                  "properties": {
                    "kind": { "enum": ["practice", "qualifying", "shootout"] },
                    "name": { "type": "string" },
                    "day": { "type": "integer", "minimum": -4, "maximum": 0 },
                    "offsetHours": { "type": "number", "minimum": -12, "maximum": 12 }
                  }
                }
              }
            }
          }
        },
        "diurnal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["peakHour", "halfRangeC", "status"],
          "properties": {
            "peakHour": { "type": "number", "minimum": 0, "maximum": 24 },
            "halfRangeC": { "type": "number", "minimum": 0, "maximum": 15 },
            "status": { "$ref": "#/definitions/status" }
          }
        }
      }
    },
    "yellow": {
      "$comment": "SES-3: amarillas locales de la sesión jugable (RF-SIM-10, RF-WKD-02), calibradas con OpenF1 race_control.",
      "type": "object",
      "additionalProperties": false,
      "required": ["$comment", "status", "chance", "doubleShare", "durationSec", "eras", "regulation", "measured"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "chance": { "$ref": "#/definitions/shareByKind" },
        "doubleShare": { "$ref": "#/definitions/shareByKind" },
        "durationSec": {
          "type": "object",
          "additionalProperties": false,
          "required": ["single", "double"],
          "properties": { "single": { "$ref": "#/definitions/spread" }, "double": { "$ref": "#/definitions/spread" } }
        },
        "eras": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/yearRow" } },
        "regulation": {
          "type": "object",
          "required": ["status", "note"],
          "properties": { "status": { "$ref": "#/definitions/status" }, "note": { "type": "string" }, "source": { "$ref": "#/definitions/source" } },
          "if": { "properties": { "status": { "const": "source" } } },
          "then": { "required": ["source"] }
        },
        "measured": {
          "type": "object",
          "required": ["source", "years", "practice", "qualifying", "single", "double"],
          "properties": {
            "source": { "type": "string" },
            "years": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/year" } },
            "practice": { "$ref": "#/definitions/episodes" },
            "qualifying": { "$ref": "#/definitions/episodes" },
            "single": { "$ref": "#/definitions/spread" },
            "double": { "$ref": "#/definitions/spread" }
          }
        }
      }
    }
  }
}
