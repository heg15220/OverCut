{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "RNF-07: esquema de data/balance/hud.json (presentación del HUD de sesión y de carrera; RF-3D-04, RF-CMD-04, RF-WKD-07, RNF-09). Esquema completo desde HUD-1, también para las claves de HUD-2..HUD-7 y WKD-1 (F1M24-GAMEPLAY §3.2). Lo comprueba components/playback.test.js.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$comment", "version", "speedCallout", "carStep", "tower", "banners", "driverPanel", "pitDialog", "pitTimer", "start", "finish", "sc", "transitionSec"],
  "definitions": {
    "status": {
      "enum": ["behaviour", "pending", "measured", "NV"]
    },
    "towerModes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["interval", "gap", "tyres", "tyresPct", "lastLap", "sectors", "stops", "status", "best"]
      }
    },
    "flagKind": {
      "enum": ["green", "yellow", "sc", "vsc", "red", "chequered", "session"]
    },
    "bannerKind": {
      "enum": ["pass", "mistake", "contact", "investigation", "penalty", "fastest", "drs", "lapsToGo", "lastLap"]
    },
    "panelTab": {
      "enum": ["status", "tactics", "telemetry", "pit"]
    },
    "pendingSwitch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$comment", "status", "enabled"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "enabled": { "type": "boolean" }
      }
    }
  },
  "properties": {
    "$comment": { "type": "string" },
    "$transitionSec": { "type": "string" },
    "version": { "const": 1 },
    "speedCallout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$comment", "status", "showMs"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "showMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "carStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$comment", "status", "skipOut"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "skipOut": { "type": "boolean" }
      }
    },
    "tower": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$comment", "status", "modes", "byEra", "session", "flags", "header"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "modes": { "$ref": "#/definitions/towerModes" },
        "byEra": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "modes"],
            "properties": {
              "from": {
                "type": "integer",
                "minimum": 1950,
                "maximum": 2100
              },
              "to": {
                "type": "integer",
                "minimum": 1950,
                "maximum": 2100
              },
              "modes": { "$ref": "#/definitions/towerModes" }
            }
          }
        },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": ["$comment", "status", "modes"],
          "properties": {
            "$comment": { "type": "string" },
            "status": { "$ref": "#/definitions/status" },
            "modes": { "$ref": "#/definitions/towerModes" }
          }
        },
        "flags": {
          "type": "object",
          "additionalProperties": false,
          "required": ["$comment", "status", "incident", "outLap", "inLap", "finished"],
          "properties": {
            "$comment": { "type": "string" },
            "status": { "$ref": "#/definitions/status" },
            "incident": {
              "type": "object",
              "additionalProperties": false,
              "required": ["events", "investigation", "holdSec"],
              "properties": {
                "events": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "investigation": { "type": "boolean" },
                "holdSec": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 120
                }
              }
            },
            "outLap": { "type": "boolean" },
            "inLap": { "type": "boolean" },
            "finished": { "type": "boolean" }
          }
        },
        "header": {
          "type": "object",
          "additionalProperties": false,
          "required": ["$comment", "status", "kinds", "sectorLabel"],
          "properties": {
            "$comment": { "type": "string" },
            "status": { "$ref": "#/definitions/status" },
            "kinds": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/definitions/flagKind" }
            },
            "sectorLabel": { "type": "boolean" }
          }
        }
      }
    },
    "banners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$comment", "status", "kinds", "durationSec", "lapsToGoCallouts"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/bannerKind" }
        },
        "durationSec": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0,
          "maximum": 30
        },
        "lapsToGoCallouts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "queueMax": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "staleSimSec": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 600
        },
        "byKind": {
          "type": "object",
          "propertyNames": { "$ref": "#/definitions/bannerKind" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "scope": { "enum": ["all", "own", "top"] },
              "top": {
                "type": "integer",
                "minimum": 1,
                "maximum": 30
              },
              "priority": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              "durationSec": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 30
              },
              "kinds": {
                "type": "array",
                "uniqueItems": true,
                "items": { "enum": ["spin", "wide", "lockup"] }
              }
            }
          }
        },
        "activeAero": { "$ref": "#/definitions/pendingSwitch" },
        "replay": { "$ref": "#/definitions/pendingSwitch" }
      }
    },
    "driverPanel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$comment", "status", "tabs", "defaultTab", "tyreLife", "fuel", "engineTemp", "stopWindow", "tyreTemp"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "tabs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/panelTab" }
        },
        "defaultTab": { "$ref": "#/definitions/panelTab" },
        "tyreLife": {
          "type": "object",
          "additionalProperties": false,
          "required": ["warnBelow", "badBelow"],
          "properties": {
            "warnBelow": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "badBelow": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "fuel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["warnLaps"],
          "properties": {
            "warnLaps": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            }
          }
        },
        "engineTemp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "enabled"],
          "properties": {
            "status": { "$ref": "#/definitions/status" },
            "enabled": { "type": "boolean" }
          }
        },
        "stopWindow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "source"],
          "properties": {
            "status": { "$ref": "#/definitions/status" },
            "source": { "type": "string" }
          }
        },
        "tyreTemp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["$comment", "status", "source", "judgeNode", "showCarcass", "nearEdgeC", "trend"],
          "properties": {
            "$comment": { "type": "string" },
            "status": { "$ref": "#/definitions/status" },
            "source": { "type": "string" },
            "judgeNode": { "enum": ["surface", "carcass", "grip"] },
            "showCarcass": { "type": "boolean" },
            "nearEdgeC": { "type": "number", "minimum": 0, "maximum": 30 },
            "trend": {
              "type": "object",
              "additionalProperties": false,
              "required": ["spanSec", "deadbandC", "minStepC", "refreshSec", "staleSec", "keepSec"],
              "properties": {
                "spanSec": { "type": "number", "exclusiveMinimum": 0, "maximum": 600 },
                "deadbandC": { "type": "number", "minimum": 0, "maximum": 30 },
                "minStepC": { "type": "number", "minimum": 0, "maximum": 10 },
                "refreshSec": { "type": "number", "exclusiveMinimum": 0, "maximum": 600 },
                "staleSec": { "type": "number", "exclusiveMinimum": 0, "maximum": 3600 },
                "keepSec": { "type": "number", "exclusiveMinimum": 0, "maximum": 3600 }
              }
            }
          }
        }
      }
    },
    "pitDialog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$comment", "status", "pauseOnOpen", "quickCall", "lapPicker"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "pauseOnOpen": { "type": "boolean" },
        "quickCall": { "type": "boolean" },
        "lapPicker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "enabled"],
          "properties": {
            "status": { "$ref": "#/definitions/status" },
            "enabled": { "type": "boolean" }
          }
        }
      }
    },
    "pitTimer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$comment", "status", "holdRealSec"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "holdRealSec": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        }
      }
    },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$comment", "status", "hudDelaySec", "lightsOutBannerSec"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "hudDelaySec": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 30
        },
        "lightsOutBannerSec": { "type": "number", "minimum": 0, "maximum": 30 }
      }
    },
    "finish": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$comment", "status", "foldPanel", "chequeredBannerSec"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "foldPanel": { "type": "boolean" },
        "chequeredBannerSec": { "type": "number", "minimum": 0, "maximum": 120 }
      }
    },
    "sc": {
      "$comment": "HUD-5 (sc-pose-from-sim, el HUD): coche de seguridad y VSC leídos del motor (§1.7 sc/vsc).",
      "type": "object",
      "additionalProperties": false,
      "required": ["$comment", "status", "phaseLabels", "inThisLap", "vscEnding", "vscDelta", "map"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "phaseLabels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["$comment", "enabled"],
          "properties": { "$comment": { "type": "string" }, "enabled": { "type": "boolean" } }
        },
        "inThisLap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["$comment", "enabled", "engineFallback"],
          "properties": { "$comment": { "type": "string" }, "enabled": { "type": "boolean" }, "engineFallback": { "type": "boolean" } }
        },
        "vscEnding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["$comment", "enabled"],
          "properties": { "$comment": { "type": "string" }, "enabled": { "type": "boolean" } }
        },
        "vscDelta": {
          "type": "object",
          "additionalProperties": false,
          "required": ["$comment", "enabled", "positiveMeans", "tightBelowSec", "decimals"],
          "properties": {
            "$comment": { "type": "string" },
            "enabled": { "type": "boolean" },
            "positiveMeans": { "enum": ["margin", "deficit"] },
            "tightBelowSec": { "type": "number", "minimum": 0, "maximum": 10 },
            "decimals": { "type": "integer", "minimum": 0, "maximum": 3 }
          }
        },
        "map": {
          "type": "object",
          "additionalProperties": false,
          "required": ["$comment", "enabled", "staleSec"],
          "properties": {
            "$comment": { "type": "string" },
            "enabled": { "type": "boolean" },
            "staleSec": { "type": "number", "minimum": 0, "maximum": 60 }
          }
        }
      }
    },
    "transitionSec": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 15
    }
  }
}
