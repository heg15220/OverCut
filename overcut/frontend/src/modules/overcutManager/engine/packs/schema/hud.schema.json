{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "RNF-07: esquema de data/balance/hud.json (presentación del HUD de sesión y de carrera; RF-3D-04, RF-CMD-04, RF-WKD-07, RNF-09). Esquema completo desde HUD-1, también para las claves de HUD-2..HUD-7 y WKD-1 (F1M24-GAMEPLAY §3.2). Lo comprueba components/playback.test.js.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$comment", "version", "speedCallout", "carStep", "tower", "banners", "start", "transitionSec"],
  "definitions": {
    "status": {
      "enum": ["behaviour", "pending", "measured", "NV"]
    },
    "towerModes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["interval", "gap", "tyres", "tyresPct", "lastLap", "sectors", "stops", "status", "best"]
      }
    },
    "flagKind": {
      "enum": ["green", "yellow", "sc", "vsc", "red", "chequered", "session"]
    }
  },
  "properties": {
    "$comment": { "type": "string" },
    "$transitionSec": { "type": "string" },
    "version": { "const": 1 },
    "speedCallout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$comment", "status", "showMs"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "showMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "carStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$comment", "status", "skipOut"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "skipOut": { "type": "boolean" }
      }
    },
    "tower": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$comment", "status", "modes", "byEra", "session", "flags", "header"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "modes": { "$ref": "#/definitions/towerModes" },
        "byEra": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "modes"],
            "properties": {
              "from": {
                "type": "integer",
                "minimum": 1950,
                "maximum": 2100
              },
              "to": {
                "type": "integer",
                "minimum": 1950,
                "maximum": 2100
              },
              "modes": { "$ref": "#/definitions/towerModes" }
            }
          }
        },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": ["$comment", "status", "modes"],
          "properties": {
            "$comment": { "type": "string" },
            "status": { "$ref": "#/definitions/status" },
            "modes": { "$ref": "#/definitions/towerModes" }
          }
        },
        "flags": {
          "type": "object",
          "additionalProperties": false,
          "required": ["$comment", "status", "incident", "outLap", "inLap", "finished"],
          "properties": {
            "$comment": { "type": "string" },
            "status": { "$ref": "#/definitions/status" },
            "incident": {
              "type": "object",
              "additionalProperties": false,
              "required": ["events", "investigation", "holdSec"],
              "properties": {
                "events": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "investigation": { "type": "boolean" },
                "holdSec": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 120
                }
              }
            },
            "outLap": { "type": "boolean" },
            "inLap": { "type": "boolean" },
            "finished": { "type": "boolean" }
          }
        },
        "header": {
          "type": "object",
          "additionalProperties": false,
          "required": ["$comment", "status", "kinds", "sectorLabel"],
          "properties": {
            "$comment": { "type": "string" },
            "status": { "$ref": "#/definitions/status" },
            "kinds": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/definitions/flagKind" }
            },
            "sectorLabel": { "type": "boolean" }
          }
        }
      }
    },
    "banners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$comment", "status", "kinds", "durationSec", "lapsToGoCallouts"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "durationSec": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0,
          "maximum": 30
        },
        "lapsToGoCallouts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      }
    },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$comment", "status", "hudDelaySec"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "hudDelaySec": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 30
        }
      }
    },
    "transitionSec": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 15
    }
  }
}
