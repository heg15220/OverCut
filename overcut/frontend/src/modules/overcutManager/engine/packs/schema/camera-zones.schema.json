{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "RNF-07: zonas de cámara de TV de un circuito calibrado, data/circuits/<splineId>/camera-zones.json (F1M24-GAMEPLAY §2.5 camera-zones, CAM-2; RF-3D-03, RF-3D-04). Las genera tools/assets/camera_zones.mjs desde la geometría del circuito (three/cameraZones.js buildCameraZones) y se pueden editar a mano. Las posiciones finales de cada cámara las calcula three/cameras.js buildZoneRig con data/balance/broadcast.json rigTemplate y, en el circuito real, fitRig sobre la malla GLB. Lo comprueba three/cameras.test.js.",
  "type": "object",
  "additionalProperties": false,
  "required": ["splineId", "lengthM", "source", "zones"],
  "definitions": {
    "camType": {"enum": ["braking", "corner", "straight", "headOn", "passPan", "lateralTrack", "highWide", "grandstand", "cable", "longLens"]},
    "cam": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "atM", "side"],
      "properties": {
        "type": {"$ref": "#/definitions/camType"},
        "atM": {"type": "number", "minimum": -20000, "maximum": 40000},
        "side": {"enum": [-1, 1]},
        "cornerKind": {"enum": ["slow", "medium", "fast"]},
        "weight": {"type": "number", "minimum": 0}
      }
    }
  },
  "properties": {
    "$comment": {"type": "string"},
    "splineId": {"type": "string", "minLength": 1},
    "lengthM": {"type": "number", "exclusiveMinimum": 0, "maximum": 30000},
    "year": {"type": "integer", "minimum": 1950, "maximum": 2100},
    "source": {"type": "string", "minLength": 1},
    "edited": {"type": "boolean"},
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fromM", "toM", "kind", "cams"],
        "properties": {
          "fromM": {"type": "number", "minimum": 0, "maximum": 30000},
          "toM": {"type": "number", "exclusiveMinimum": 0, "maximum": 60000},
          "kind": {"enum": ["corner", "braking", "straight", "line"]},
          "corners": {"type": "array", "items": {"type": "integer", "minimum": 1}},
          "cams": {"type": "array", "items": {"$ref": "#/definitions/cam"}, "minItems": 1, "maxItems": 3}
        }
      }
    }
  }
}
