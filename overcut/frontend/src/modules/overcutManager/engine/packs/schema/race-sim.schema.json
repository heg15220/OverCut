          "required": ["eras"],
          "properties": {
            "$comment": { "type": "string" },
            "settleSec": { "$ref": "#/definitions/nonNegative" },
            "settleStatus": { "enum": ["source", "measured", "pending"] },
            "settleNote": { "type": "string" },
            "eras": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["from", "to", "value", "source", "status"],
