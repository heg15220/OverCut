                  "$comment": { "type": "string" },
                  "from": { "type": "integer" },
                  "to": { "type": "integer" },
                  "value": { "$ref": "#/definitions/nonNegative" },
                  "source": { "type": "string", "minLength": 3 },
                  "status": { "enum": ["source", "measured", "pending"] },
                  "note": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "dirtyAir": {
      "type": "object",
