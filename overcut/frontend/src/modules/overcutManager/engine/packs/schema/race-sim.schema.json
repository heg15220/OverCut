    },
    "neutralisation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "circuitRate",
        "severity",
        "cleanup",
        "laps"
      ],
      "properties": {
        "$comment": {
          "type": "string"
        },
        "circuitRate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference",
            "min",
            "max"
          ],
          "properties": {
            "$comment": {
              "type": "string"
            },
            "reference": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "min": {
              "$ref": "#/definitions/positive"
            },
            "max": {
              "$ref": "#/definitions/positive"
            },
            "source": {
              "type": "string"
            }
          }
        },
        "severity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "byReason",
            "default",
            "debris"
          ],
          "properties": {
            "$comment": {
              "type": "string"
            },
            "byReason": {
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "impact",
                  "stopped",
                  "debris"
                ]
              }
            },
            "default": {
              "enum": [
                "impact",
                "stopped",
                "debris"
              ]
            },
            "debris": {
              "enum": [
                "impact",
                "stopped",
                "debris"
              ]
            }
          }
        },
        "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base",
            "offTrackFactor",
            "perSeverity"
          ],
          "properties": {
            "$comment": {
              "type": "string"
            },
            "base": {
              "$ref": "#/definitions/holdSpread"
            },
            "offTrackFactor": {
              "$ref": "#/definitions/positive"
            },
            "offTrackNote": {
              "type": "string"
            },
            "perSeverity": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "impact",
                "stopped",
                "debris"
              ],
              "properties": {
                "$comment": {
                  "type": "string"
                },
                "impact": {
                  "$ref": "#/definitions/positive"
                },
                "stopped": {
                  "$ref": "#/definitions/positive"
                },
                "debris": {
                  "$ref": "#/definitions/positive"
                }
              }
            },
            "pending": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "pendingNote": {
              "type": "string"
            }
          }
        },
        "laps": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unlappingSec",
            "inThisLapLaps",
            "minSc",
            "minVsc"
          ],
          "properties": {
            "$comment": {
              "type": "string"
            },
            "unlappingSec": {
              "$ref": "#/definitions/nonNegative"
            },
            "unlappingNote": {
              "type": "string"
            },
            "inThisLapLaps": {
              "type": "integer",
              "minimum": 0
            },
            "inThisLapNote": {
              "type": "string"
            },
            "minSc": {
              "type": "integer",
              "minimum": 1
            },
            "minVsc": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "raceControl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "yellow"
      ],
      "properties": {
        "$comment": {
          "type": "string"
        },
        "yellow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approachMetres",
            "afterMetres",
            "durationSec",
            "slowFactor",
            "holdSec",
            "double",
            "measured"
          ],
          "properties": {
            "$comment": { "type": "string" },
            "approachMetres": {
              "$ref": "#/definitions/nonNegative"
            },
            "afterMetres": {
              "$ref": "#/definitions/nonNegative"
            },
            "durationSec": {
              "$ref": "#/definitions/nonNegative"
            },
            "slowFactor": {
              "$ref": "#/definitions/nonNegative"
            },
            "holdSec": {
              "type": "object",
              "additionalProperties": false,
              "required": ["single", "double"],
              "properties": {
                "single": { "$ref": "#/definitions/holdSpread" },
                "double": { "$ref": "#/definitions/holdSpread" }
              }
            },
            "double": {
              "type": "object",
              "additionalProperties": false,
              "required": ["incidents", "retired"],
              "properties": {
                "$comment": { "type": "string" },
                "incidents": { "type": "array", "items": { "enum": ["lockup", "wide", "spin"] }, "uniqueItems": true },
                "retired": { "type": "boolean" }
              }
            },
            "measured": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "years", "races", "episodes", "perRace", "doubleShare", "single", "double"],
              "properties": {
                "source": { "type": "string", "minLength": 1 },
                "years": { "type": "array", "items": { "type": "integer" }, "minItems": 1 },
                "races": { "type": "integer", "minimum": 1 },
                "episodes": { "type": "integer", "minimum": 0 },
                "perRace": { "$ref": "#/definitions/nonNegative" },
                "doubleShare": { "$ref": "#/definitions/share" },
                "single": { "$ref": "#/definitions/measuredSpread" },
                "double": { "$ref": "#/definitions/measuredSpread" }
              }
            },
            "pending": { "type": "array", "items": { "type": "string" } },
            "pendingNote": { "type": "string" }
          }
        }
      }
    },
    "mistake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slowFactor"
      ],
      "properties": {
        "$comment": {
          "type": "string"
        },
        "slowFactor": {
          "$ref": "#/definitions/nonNegative"
        }
      }
    },
    "pitRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crewCeiling",
        "crewScale"
      ],
      "properties": {
        "$comment": {
          "type": "string"
        },
        "crewCeiling": {
          "$ref": "#/definitions/positive"
        },
        "crewScale": {
          "$ref": "#/definitions/positive"
        }
      }
    },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "required": ["procedures", "gridSettleSec", "formation", "pending"],
      "properties": {
        "$comment": { "type": "string" },
        "procedures": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lights", "lightIntervalSec", "holdSec"],
            "properties": {
              "$comment": { "type": "string" },
              "lights": { "type": "integer", "minimum": 1, "maximum": 5 },
              "lightIntervalSec": { "$ref": "#/definitions/positive" },
              "holdSec": {
                "type": "object",
                "additionalProperties": false,
                "required": ["min", "max"],
                "properties": {
                  "min": { "$ref": "#/definitions/nonNegative" },
                  "max": { "$ref": "#/definitions/nonNegative" }
                }
              }
            }
          }
        },
        "gridSettleSec": { "$ref": "#/definitions/nonNegative" },
        "formation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lapFactor", "departStaggerSec", "arriveStaggerSec", "abortChance", "pitStart"],
          "properties": {
            "$comment": { "type": "string" },
            "lapFactor": { "type": "number", "minimum": 1 },
            "departStaggerSec": { "$ref": "#/definitions/nonNegative" },
            "arriveStaggerSec": { "$ref": "#/definitions/nonNegative" },
            "abortChance": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/share" }] },
            "pitStart": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/share" }] }
          }
        },
        "pending": { "type": "array", "items": { "type": "string" } },
        "pendingNote": { "type": "string" }
      }
    },
    "cooldown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lapFactor", "slowDownSec", "lateralMetres", "pending"],
      "properties": {
        "$comment": { "type": "string" },
        "lapFactor": { "type": "number", "minimum": 1 },
        "slowDownSec": { "$ref": "#/definitions/positive" },
        "lateralMetres": { "$ref": "#/definitions/nonNegative" },
        "pending": { "type": "array", "items": { "type": "string" } }
      }
    },
    "radio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "gaining", "closing", "quietSec"],
      "properties": {
        "$comment": { "type": "string" },
        "enabled": { "type": "boolean" },
        "gaining": { "$ref": "#/definitions/radioGap" },
        "closing": { "$ref": "#/definitions/radioGap" },
        "quietSec": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gaining", "closing", "attack-failed", "passed", "defended", "lost"],
          "properties": {
            "gaining": { "$ref": "#/definitions/nonNegative" },
            "closing": { "$ref": "#/definitions/nonNegative" },
            "attack-failed": { "$ref": "#/definitions/nonNegative" },
            "passed": { "$ref": "#/definitions/nonNegative" },
            "defended": { "$ref": "#/definitions/nonNegative" },
            "lost": { "$ref": "#/definitions/nonNegative" }
          }
        }
      }
    },
    "tactics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaults", "avoidKerbs", "cleanAir", "battleAssist"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "type": "string" },
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "required": ["avoidKerbs", "cleanAir", "battleAssist"],
          "properties": { "avoidKerbs": { "type": "boolean" }, "cleanAir": { "type": "boolean" }, "battleAssist": { "type": "boolean" } }
        },
        "avoidKerbs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lapLossShare", "mistakeFactor", "trackLimitsFactor", "floorDamageFactor"],
          "properties": {
            "lapLossShare": { "$ref": "#/definitions/nonNegative" },
            "mistakeFactor": { "$ref": "#/definitions/nonNegative" },
            "trackLimitsFactor": { "$ref": "#/definitions/nonNegative" },
            "floorDamageFactor": { "$ref": "#/definitions/nonNegative" }
          }
        },
        "cleanAir": {
          "type": "object",
          "additionalProperties": false,
          "required": ["targetGapSec", "maxDropSecPerLap"],
          "properties": { "targetGapSec": { "$ref": "#/definitions/nonNegative" }, "maxDropSecPerLap": { "$ref": "#/definitions/nonNegative" } }
        },
        "battleAssist": {
          "type": "object",
          "additionalProperties": false,
          "required": ["withinSec", "minBatteryPct"],
          "properties": { "withinSec": { "$ref": "#/definitions/nonNegative" }, "minBatteryPct": { "$ref": "#/definitions/nonNegative" } }
        }
      }
    }
  }
}
