    "step",
    "grid",
    "lapOne",
    "traffic",
    "dirtyAir",
    "slipstream",
    "drs",
    "redFlag",
    "duel",
    "defence",
    "risk",
    "teamOrders",
    "blueFlags",
    "safetyCar",
    "raceControl",
    "mistake",
    "pitRelease",
    "start",
    "cooldown"
