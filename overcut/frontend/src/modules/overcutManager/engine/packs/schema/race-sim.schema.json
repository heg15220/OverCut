{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "RNF-07 (rnf07-race, SIM-1 de docs/manager/F1M24-GAMEPLAY.md): esquema de data/balance/race-sim.json, el balance del simulador por pasos (engine/sim/stepRace.js, duel.js) y los términos del adelantamiento que comparte el modo rápido (race.js passChanceOf lee duel). Cerrado: una clave nueva se añade aquí a la vez que en el JSON. Lo comprueba engine/sim/simBalance.test.js.",
  "definitions": {
    "nonNegative": {
      "type": "number",
      "minimum": 0
    },
    "positive": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "share": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "holdSpread": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p10", "median", "p90"],
      "properties": {
        "p10": { "type": "number", "exclusiveMinimum": 0 },
        "median": { "type": "number", "exclusiveMinimum": 0 },
        "p90": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "measuredSpread": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "p10", "median", "p90"],
      "properties": {
        "n": { "type": "integer", "minimum": 0 },
        "p10": { "type": "number", "minimum": 0 },
        "median": { "type": "number", "minimum": 0 },
        "p90": { "type": "number", "minimum": 0 }
      }
    },
    "radioGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["withinSec", "minGainSecPerLap"],
      "properties": {
        "withinSec": { "type": "number", "exclusiveMinimum": 0 },
        "minGainSecPerLap": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "eraRange": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "type": "integer",
          "minimum": 1900
        },
        "to": {
          "type": "integer",
          "maximum": 2100
        }
      },
      "additionalProperties": {
        "type": "number"
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "step",
    "grid",
    "lapOne",
    "traffic",
    "dirtyAir",
    "slipstream",
    "drs",
    "redFlag",
    "duel",
    "defence",
    "risk",
    "teamOrders",
    "blueFlags",
    "safetyCar",
    "raceControl",
    "mistake",
    "pitRelease",
    "start",
    "cooldown",
    "radio",
    "vsc",
    "neutralisation"
