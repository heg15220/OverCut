{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "SIM-6 (termica-neumatico, docs/manager/F1M24-GAMEPLAY.md §2.8; RF-SIM-03, RNF-07): esquema de data/balance/race-tyres.json, la temperatura del neumático en °C de engine/tyres/thermal.js. Cerrado en todos sus bloques. Lo comprueba engine/tyres/thermal.test.js.",
  "definitions": {
    "nonNegative": { "type": "number", "minimum": 0 },
    "positive": { "type": "number", "exclusiveMinimum": 0 },
    "share": { "type": "number", "minimum": 0, "maximum": 1 },
    "celsius": { "type": "number", "minimum": -30, "maximum": 200 },
    "status": { "type": "string", "enum": ["pending"] },
    "window": {
      "type": "array",
      "items": { "$ref": "#/definitions/celsius" },
      "minItems": 2,
      "maxItems": 2
    },
    "year": { "type": "integer", "minimum": 1950, "maximum": 2030 }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "integration", "model", "paceHeat", "dirtyAirHeat", "neutralHeat", "wet", "load", "formation", "blankets", "windows", "gripCurve", "calls", "calibration"],
  "properties": {
    "$comment": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dtSec"],
      "properties": {
        "$comment": { "type": "string" },
        "dtSec": { "type": "number", "exclusiveMinimum": 0, "maximum": 5 }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surfaceHeatCPerSec", "airLossPerSec", "trackLossPerSec", "surfaceToCarcassPerSec", "carcassFromSurfacePerSec", "carcassLossPerSec", "gripCarcassShare",
        "airBelowTrackC", "fallbackTrackC", "ambientShare", "ambientRefTrackC", "ambientRefAirC"
      ],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "surfaceHeatCPerSec": { "$ref": "#/definitions/positive" },
        "airLossPerSec": { "$ref": "#/definitions/nonNegative" },
        "trackLossPerSec": { "$ref": "#/definitions/nonNegative" },
        "surfaceToCarcassPerSec": { "$ref": "#/definitions/positive" },
        "carcassFromSurfacePerSec": { "$ref": "#/definitions/positive" },
        "carcassLossPerSec": { "$ref": "#/definitions/nonNegative" },
        "gripCarcassShare": { "$ref": "#/definitions/share" },
        "airBelowTrackC": { "type": "number", "minimum": -10, "maximum": 40 },
        "fallbackTrackC": { "$ref": "#/definitions/celsius" },
        "ambientShare": { "$ref": "#/definitions/share" },
        "ambientRefTrackC": { "$ref": "#/definitions/celsius" },
        "ambientRefAirC": { "$ref": "#/definitions/celsius" }
      }
    },
    "paceHeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conserve", "save", "normal", "push", "attack"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "conserve": { "$ref": "#/definitions/positive" },
        "save": { "$ref": "#/definitions/positive" },
        "normal": { "$ref": "#/definitions/positive" },
        "push": { "$ref": "#/definitions/positive" },
        "attack": { "$ref": "#/definitions/positive" }
      }
    },
    "dirtyAirHeat": { "$ref": "#/definitions/nonNegative" },
    "neutralHeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sc", "vsc"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "sc": { "$ref": "#/definitions/share" },
        "vsc": { "$ref": "#/definitions/share" }
      }
    },
    "wet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heatCut", "trackDropC"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "heatCut": { "$ref": "#/definitions/share" },
        "trackDropC": { "$ref": "#/definitions/nonNegative" }
      }
    },
    "load": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latWeight", "lonWeight", "floor"],
      "properties": {
        "$comment": { "type": "string" },
        "latWeight": { "$ref": "#/definitions/nonNegative" },
        "lonWeight": { "$ref": "#/definitions/nonNegative" },
        "floor": { "$ref": "#/definitions/positive" }
      }
    },
    "formation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lapFactor", "heat"],
      "properties": {
        "$comment": { "type": "string" },
        "status": { "$ref": "#/definitions/status" },
        "lapFactor": { "$ref": "#/definitions/positive" },
        "heat": { "$ref": "#/definitions/positive" }
      }
    },
    "blankets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "allowed"],
        "properties": {
          "from": { "$ref": "#/definitions/year" },
          "to": { "$ref": "#/definitions/year" },
          "allowed": { "type": "boolean" },
          "tempC": { "$ref": "#/definitions/celsius" },
          "status": { "$ref": "#/definitions/status" },
          "note": { "type": "string" },
          "source": { "type": "string" }
        },
        "if": { "properties": { "allowed": { "const": true } } },
        "then": { "properties": { "tempC": true }, "required": ["tempC"] },
        "anyOf": [{ "properties": { "status": true, "note": true }, "required": ["status", "note"] }, { "properties": { "source": true }, "required": ["source"] }]
      }
    },
    "windows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "compounds"],
        "properties": {
          "from": { "$ref": "#/definitions/year" },
          "to": { "$ref": "#/definitions/year" },
          "status": { "$ref": "#/definitions/status" },
          "note": { "type": "string" },
          "source": { "type": "string" },
          "compounds": {
            "type": "object",
            "required": ["dry"],
            "properties": { "dry": { "$ref": "#/definitions/window" } },
            "propertyNames": { "enum": ["dry", "soft", "medium", "hard", "inter", "wet"] },
            "additionalProperties": { "$ref": "#/definitions/window" }
          }
        }
      }
    },
    "gripCurve": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coldSecPerC", "hotSecPerC", "hotWearPerC", "mistakeColdPerC"],
      "properties": {
        "$comment": { "type": "string" },
        "coldSecPerC": { "$ref": "#/definitions/nonNegative" },
        "hotSecPerC": { "$ref": "#/definitions/nonNegative" },
        "hotWearPerC": { "$ref": "#/definitions/nonNegative" },
        "mistakeColdPerC": { "$ref": "#/definitions/nonNegative" }
      }
    },
    "calls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passColdBelowC", "saveAboveC", "radioHotAboveC"],
      "properties": {
        "$comment": { "type": "string" },
        "passColdBelowC": { "type": "number" },
        "saveAboveC": { "type": "number" },
        "radioHotAboveC": { "type": "number" }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "outLapLossSec", "flyingLapLossSec"],
      "properties": {
        "$comment": { "type": "string" },
        "source": { "type": "string" },
        "outLapLossSec": {
          "type": "array",
          "items": { "$ref": "#/definitions/nonNegative" },
          "minItems": 2,
          "maxItems": 2
        },
        "flyingLapLossSec": { "$ref": "#/definitions/nonNegative" }
      }
    }
  }
}
