{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "RNF-07: esquema de data/balance/weekend-ui.json (puerta de sesión, transición y resultados del fin de semana; RF-WKD-01, RF-WKD-02, RF-WKD-07). Lo comprueba components/sessionFlow.test.js.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "transition", "results", "gate"],
  "properties": {
    "$comment": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inSec", "holdSec", "outSec", "skippable", "status"],
      "properties": {
        "$comment": {"type": "string"},
        "inSec": {"type": "number", "minimum": 0, "maximum": 3},
        "holdSec": {"type": "number", "minimum": 0, "maximum": 5},
        "outSec": {"type": "number", "minimum": 0, "maximum": 3},
        "skippable": {"type": "boolean"},
        "status": {"enum": ["design", "pending", "source"]},
        "note": {"type": "string"}
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageSize"],
      "properties": {
        "$comment": {"type": "string"},
        "pageSize": {"type": "integer", "minimum": 5, "maximum": 30}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultChoice", "confirm"],
      "properties": {
        "$comment": {"type": "string"},
        "defaultChoice": {"enum": ["manage", "simulate", "toRace"]},
        "confirm": {"type": "boolean"}
      }
    },
    "practiceSummary": {
      "$comment": "WKD-2 practice-goals-summary (RF-WKD-03, RF-WKD-07): el resumen de los libres en SessionResults. Opcional: sin él no se pinta el panel.",
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence"],
      "properties": {
        "$comment": {"type": "string"},
        "confidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["neutral", "levels", "status"],
          "properties": {
            "$comment": {"type": "string"},
            "neutral": {"type": "number", "minimum": 0, "maximum": 1},
            "levels": {
              "$comment": "RF-WKD-03: seis niveles, de menor a mayor; el primero empieza en 0.",
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "from"],
                "properties": {
                  "id": {"enum": ["lost", "low", "unsure", "settled", "high", "peak"]},
                  "from": {"type": "number", "minimum": 0, "maximum": 1}
                }
              }
            },
            "status": {"enum": ["design", "pending", "source"]},
            "note": {"type": "string"}
          }
        }
      }
    }
  }
}
