{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "RNF-07: esquema de data/balance/race-powertrain.json (unidad de potencia, caja de cambios e inercia; RF-SIM-01, RF-SIM-02, RF-DEV-01). Lo comprueba engine/sim/powertrain.test.js.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "gearShape", "fit", "shift", "smoothing", "launch", "liftCoast", "eras"],
  "definitions": {
    "positive": {"type": "number", "exclusiveMinimum": 0},
    "nonNegative": {"type": "number", "minimum": 0},
    "share": {"type": "number", "minimum": 0, "maximum": 1},
    "rpm": {"type": "number", "minimum": 500, "maximum": 25000},
    "text": {"type": "string", "minLength": 1}
  },
  "properties": {
    "$comment": {"type": "string"},
    "version": {"const": 1},
    "gearShape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shares", "source"],
      "properties": {
        "$comment": {"type": "string"},
        "shares": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}},
        "source": {"$ref": "#/definitions/text"}
      }
    },
    "fit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["towMargin", "seasonTopShare"],
      "properties": {"$comment": {"type": "string"}, "towMargin": {"type": "number", "minimum": 0, "maximum": 0.2}, "seasonTopShare": {"type": "number", "minimum": 0.8, "maximum": 1.2}}
    },
    "shift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brakingG"],
      "properties": {"$comment": {"type": "string"}, "brakingG": {"$ref": "#/definitions/positive"}}
    },
    "smoothing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accelSec"],
      "properties": {"$comment": {"type": "string"}, "accelSec": {"$ref": "#/definitions/nonNegative"}}
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repayMaxShare", "fuelSource"],
      "properties": {"$comment": {"type": "string"}, "repayMaxShare": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.2}, "fuelSource": {"$ref": "#/definitions/text"}}
    },
    "liftCoast": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minStraightMetres", "maxShareOfStraight", "searchMaxMetres"],
      "properties": {
        "$comment": {"type": "string"},
        "minStraightMetres": {"$ref": "#/definitions/positive"},
        "maxShareOfStraight": {"$ref": "#/definitions/share"},
        "searchMaxMetres": {"$ref": "#/definitions/positive"}
      }
    },
    "eras": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "engine", "gearbox", "chassis", "launchMu", "raceFuelKg", "source"],
        "properties": {
          "from": {"type": "integer", "minimum": 1950, "maximum": 2100},
          "to": {"type": "integer", "minimum": 1950, "maximum": 2100},
          "engine": {
            "type": "object",
            "additionalProperties": false,
            "required": ["spec", "limitRpm", "shiftRpm", "downRpm", "floorRpm", "idleRpm", "launchRpm", "curve", "frictionKw", "harvestKw"],
            "properties": {
              "spec": {"$ref": "#/definitions/text"},
              "limitRpm": {"$ref": "#/definitions/rpm"},
              "shiftRpm": {"$ref": "#/definitions/rpm"},
              "downRpm": {"$ref": "#/definitions/rpm"},
              "floorRpm": {"$ref": "#/definitions/rpm"},
              "idleRpm": {"$ref": "#/definitions/rpm"},
              "launchRpm": {"$ref": "#/definitions/rpm"},
              "curve": {
                "type": "array",
                "minItems": 2,
                "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/definitions/share"}}
              },
              "frictionKw": {"$ref": "#/definitions/nonNegative"},
              "harvestKw": {"$ref": "#/definitions/nonNegative"}
            }
          },
          "gearbox": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gears", "ratios", "topGearRpm"],
            "properties": {
              "gears": {"type": "integer", "minimum": 3, "maximum": 8},
              "ratios": {"enum": ["perCircuit", "perSeason"]},
              "topGearRpm": {"$ref": "#/definitions/rpm"}
            }
          },
          "chassis": {
            "type": "object",
            "additionalProperties": false,
            "required": ["wheelbaseM", "cgHeightM", "frontShare", "pitchDegPerG", "rollDegPerG"],
            "properties": {
              "wheelbaseM": {"type": "number", "minimum": 2, "maximum": 4},
              "cgHeightM": {"type": "number", "minimum": 0.1, "maximum": 0.6},
              "frontShare": {"$ref": "#/definitions/share"},
              "pitchDegPerG": {"$ref": "#/definitions/nonNegative"},
              "rollDegPerG": {"$ref": "#/definitions/nonNegative"}
            }
          },
          "launchMu": {"type": "number", "minimum": 0.5, "maximum": 2.5},
          "raceFuelKg": {"$ref": "#/definitions/nonNegative"},
          "source": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"$ref": "#/definitions/text"}
          }
        }
      }
    }
  }
}
