  "voicing": {
    "$comment": "NV, diseño propio: pesos de armónicos sobre la frecuencia de ciclo (rpm/120, un ciclo de cuatro tiempos son dos vueltas). El armónico 'cilindros' es la frecuencia de encendido rpm/60 × cilindros/2; 'overtones' son sus múltiplos, 'halfOrder' el orden de media encendido (cada bancada) y 'roughness' el resto (irregularidad entre cilindros). 'brightness' abre el filtro con la carga.",
    "maxHarmonics": 64,
    "byCylinders": {
      "4": {"overtones": [1, 0.55, 0.3, 0.16], "halfOrder": 0.35, "roughness": 0.12, "brightness": 0.7},
      "6": {"overtones": [1, 0.6, 0.32, 0.18], "halfOrder": 0.3, "roughness": 0.1, "brightness": 0.75},
      "8": {"overtones": [1, 0.62, 0.35, 0.2], "halfOrder": 0.28, "roughness": 0.08, "brightness": 0.85},
      "10": {"overtones": [1, 0.7, 0.42, 0.24], "halfOrder": 0.22, "roughness": 0.06, "brightness": 0.95},
      "12": {"overtones": [1, 0.72, 0.46, 0.28], "halfOrder": 0.18, "roughness": 0.05, "brightness": 1.0}
    },
    "layoutHalfOrder": {"$comment": "NV: un bóxer (F) suena más parejo; un W tres bancadas", "V": 1, "F": 0.6, "W": 1.2, "L": 1.3},
    "turboMuffle": 0.75,
    "noise": {"intakeGain": 0.18, "exhaustGain": 0.22, "bandQ": 1.4, "exhaustOrder": 1, "intakeOrder": 2},
    "filter": {"minHz": 700, "maxHz": 9000, "q": 0.7},
    "load": {"$comment": "NV: carga del acelerador por la aceleración longitudinal (m/s²): <= offAccel es retención, >= onAccel gas a fondo", "offAccel": -4, "onAccel": 0.5, "overrunGain": 0.55},
    "downshiftShare": 0.62,
    "launchShare": 0.45,
    "limiterHz": 14,
    "limiterDepth": 0.6,
    "pitLimiterGear": 2,
    "crackleRatePerSec": 9,
    "crackleGain": 0.35,
    "smoothingSec": 0.04
  },
  "mixer": {
    "storageKey": "overcut.manager.audio.v1",
    "defaults": {"master": 0.7, "engine": 0.8, "ambience": 0.6, "muted": false},
    "volumeCurve": {"$comment": "NV: posición del mando a dB lineal, 0 es silencio", "minDb": -42},
    "maxVoices": 6,
