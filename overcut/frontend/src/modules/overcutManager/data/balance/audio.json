    "doppler": {"speedOfSound": 343, "minFactor": 0.6, "maxFactor": 1.6, "source": "soundSpeed: 343 m/s en aire seco a 20 °C"},
    "masterLimiter": {"threshold": -10, "knee": 8, "ratio": 6},
    "cameras": {
      "$comment": "NV: mezcla por cámara de LiveRace (RF-3D-04). Oyente: 'car' va con el coche enfocado (offset en metros: atrás, lado, alto); 'post' es un poste de TV junto a la pista delante del coche que se recoloca cuando el coche lo pasa; 'above' sobre el coche. 'focus' y 'field' son las ganancias del coche enfocado y del resto; 'interior' sube la admisión y oscurece el escape (a bordo).",
      "groups": {"onboard": ["tcam", "visor", "nose", "tcamRear"], "chase": ["chase", "drone"], "tv": ["tv"], "heli": ["heli"], "map": ["map", "follow"]},
      "mix": {
        "onboard": {"listener": "car", "back": 0, "side": 0, "up": 1, "focus": 1.0, "field": 0.55, "interior": 1, "crowd": 0.35, "wind": 1.0, "lowpassHz": 12000},
        "chase": {"listener": "car", "back": 9, "side": 0, "up": 2.5, "focus": 0.9, "field": 0.7, "interior": 0, "crowd": 0.55, "wind": 0.45, "lowpassHz": 14000},
        "tv": {"listener": "post", "ahead": 160, "side": 25, "up": 6, "passBehind": 120, "focus": 1.0, "field": 0.85, "interior": 0, "crowd": 1.0, "wind": 0.15, "lowpassHz": 16000},
        "heli": {"listener": "above", "back": 0, "side": 30, "up": 140, "focus": 1.0, "field": 0.9, "interior": 0, "crowd": 0.7, "wind": 0.6, "lowpassHz": 5000},
        "map": {"listener": "above", "back": 0, "side": 0, "up": 220, "focus": 1.0, "field": 0.8, "interior": 0, "crowd": 0.6, "wind": 0.2, "lowpassHz": 4000}
      }
